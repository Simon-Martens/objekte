+    file.write_all(&checksum).map_err(|e| e.to_string())?;
+    file.write_all(&bytes).map_err(|e| e.to_string())?;
+    Ok(SnapshotSectionSaveStats {
+        id,
+        serialize_ns,
+        checksum_ns,
+        write_ns: started.elapsed().as_nanos() as u64,
+        payload_bytes: bytes.len() as u64,
+    })
