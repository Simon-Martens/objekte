+    pub(super) fn compile_extension() -> Self {
+        Self {
+            pattern: TextPattern::compile("x", TextMode::Word, false)
+                .expect("constant extension placeholder is valid"),
+            candidate_pattern: None,
+            candidate_literal: false,
+            raw: false,
