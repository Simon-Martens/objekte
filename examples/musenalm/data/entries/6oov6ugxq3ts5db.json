      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "315",
      "incipit_statement": "Für Freiheit schwärmt’ ich, männerkühnen Muthes, / Die Pickelhaub’ erwählt ich meinem Haupt, / Es kochte wild in mir der Strom des Blutes, / An liebe nicht, an Haß hab’ ich geglaubt.",
      "language": [],
      "musenalm_id": 128340,
      "musenalm_pagination": [
