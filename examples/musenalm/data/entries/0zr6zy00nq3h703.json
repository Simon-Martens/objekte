      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "49",
      "incipit_statement": "Aus Millionen Herzen tönet wieder / Der Freudenruf im theuern Vaterland, / Ein Hochgefühl vereinet Preußens Brüder, / Und eng umschlingt sie einer Liebe Band",
      "language": [],
      "musenalm_id": 128127,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Rede / zur Feier des Allerhöchsten Geburtsfestes / Sr. Majestät des Königs. / Verfaßt von Thebesius / Im Königlichen Opernhause von Herrn Krüger, und im / Schloß-Theater zu Charlottenburg, von Herrn Rott gesprochen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Thebesius",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Rede / zur Feier des Allerhöchsten Geburtsfestes / Sr. Majestät des Königs. / Verfaßt von Thebesius / Im Königlichen Opernhause von Herrn Krüger, und im / Schloß-Theater zu Charlottenburg, von Herrn Rott gesprochen",
      "updated": "2021-07-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1837,
      "editor": "",
      "agents": [],
      "source_id": "0pmwle86bc7wpqp"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:49.257Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "51",
      "incipit_statement": "Aus kleinem Keim sah dich die Zeit entstehen / Und lebenvoll erblühn, mein Vaterland! Dem Strome gleich, der von den Alpenhöhen / Als kleine Quelle sich hernieder wand",
      "language": [],
      "musenalm_id": 128128,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Rede / zur Feier des höchstens Geburtsfestes / Sr. Königl. Hoheit des Kronprinzen. / Verfaßt von I. Thebesius / Im Königlichen Opernhause von Mad. Werner, und im Kö- / niglichen Schauspielhause  von / Madame Komitsch, gesprochen",
      "pseudonym": false,
