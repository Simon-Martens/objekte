      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "247",
      "incipit_statement": "Komm, laß uns in den Park gehen, damit ich freie Luft schöpfe und meinen gesunden Kopf behalte, denn sonst machtst du mich noch toll.",
      "language": [],
      "musenalm_id": 65347,
      "musenalm_pagination": [
