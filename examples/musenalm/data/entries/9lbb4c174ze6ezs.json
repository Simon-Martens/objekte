    {
      "annotation": "Rückblick auf die neue Welt (INr 41549, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:17:58.853Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Wir nehmen jetzt Abschied von der westlichen Erde. Vielfach waren die Merkwürdigkeiten, die großen Naturscenen, mannigfaltig die neuen Menschen und Völkerstämme, wodurch sie unsere Geographie erweiterte,",
      "language": [],
      "musenalm_id": 41550,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Erster Abschnitt / Allgemeine Schätzung des Werths der Entdek- / kung von Amerika und der seit dem letzten / Jahrhundert dort gemachten geographischen / Fortschritte",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Erster Abschnitt / Allgemeine Schätzung des Werths der Entdek- / kung von Amerika und der seit dem letzten / Jahrhundert dort gemachten geographischen / Fortschritte",
      "updated": "2005-12-02 00:00:00.000Z",
      "variant_title": "",
      "year": 1809,
      "editor": "",
      "agents": [
        {
          "annotation": "",
          "conjecture": false,
          "created": "2026-06-11 10:18:58.941Z",
