    {
      "annotation": "Bilder aus England (Sammlung INr 43642, Obj 20) Dem Text vorangestellt: Für Trauern und für Ungemüthe ist nichts so gut, / Als anzusehn ein' schöne Fraue wohlgemuth. / Walter von der Vogelweide",
      "content_type": [],
      "created": "2026-06-11 10:17:58.802Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Es wird nicht in Abrede gestellt werden, daß, unter den Bewohnerinnen von Westeuropa, die Engländerinnen am schönsten gebaut sind.",
      "language": [],
      "musenalm_id": 43643,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "1. / Die Londoner Schönen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Adrian",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "1. / Die Londoner Schönen",
      "updated": "2006-05-18 00:00:00.000Z",
