        }
      ],
      "source_id": "ek0g56fseady7qi"
    },
    {
      "annotation": "Bilder aus England (Sammlung INr 43642, Obj 20) Dem Text vorangestellt: Die Jahr' entstürmen, / Morgen Schatten und Asche, kränzt mit Myrthen / Heute den Becher. / Matthisson",
      "content_type": [],
      "created": "2026-06-11 10:17:58.802Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "15",
      "incipit_statement": "Es bedarf einer Entschuldigung, daß ich zwei so disparate Gegenstaände, wie Londner Schöne und Matrosen sind, neben einander stelle.",
      "language": [],
      "musenalm_id": 43644,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
