    {
      "annotation": "Anm. am Objekt: Aus Joh. Lane Buchanans, Missionairs der Schottischen Kirche, Reisen durch die westlichen Hebriden, während der Jahre 1782-1790. Aus dem Englischen. Berlin bey Maurer. 1812 /) mit Anm.",
      "content_type": [],
      "created": "2026-06-11 10:18:34.300Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "61",
      "incipit_statement": "Das alte Herta gehört jetzt dem Laird von Harris und ist unter dem Namen von Sankt-Kilda bekannt.",
      "language": [],
      "musenalm_id": 109132,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "VI. / Halsbrecherische Seevögeljagd auf der Insel Sankt- / Kilda in den westlichen Hebriden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Joh. Lane Buchanan [übers.] unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "VI. / Halsbrecherische Seevögeljagd auf der Insel Sankt- / Kilda in den westlichen Hebriden",
      "updated": "2015-01-22 00:00:00.000Z",
      "variant_title": "",
      "year": 1818,
      "editor": "",
      "agents": [],
      "source_id": "gdz318mhc97y1h8"
    },
    {
