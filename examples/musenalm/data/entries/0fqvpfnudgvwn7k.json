    {
      "annotation": "mit einer Illustration s. Graphik im Kalendarium 89720, Obj 6",
      "content_type": [],
      "created": "2026-06-11 10:18:28.367Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Es gibt Leute, welch über Alles, was Sage, Mährchen, Legenden u.s.w. heißt, ungläubig lächeln und die Theilnahme an derlei Erzählungen eine kindische, wo nicht gar etwas Aergeres, nennen.",
      "language": [],
      "musenalm_id": 89729,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die / weiße Frau von Collalto. / Venezianische Volkssage",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Dr. J. Siegl",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die / weiße Frau von Collalto. / Venezianische Volkssage",
      "updated": "2010-03-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1851,
      "editor": "",
      "agents": [],
      "source_id": "t98haj7f7o59r9i"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:28.367Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "41",
      "incipit_statement": "Salomo, der weise König, war, wie alle Menschenkinder: heute klug und morgen schwach, und in einem Puncte, ach! half ihm seine Weisheit wenig.",
      "language": [],
      "musenalm_id": 89730,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
