    {
      "annotation": "Dem Text vorangestellt: Alle Geister, welche danken, / Euren Weisen einen Stral' [...] Fr. Rückert",
      "content_type": [],
      "created": "2026-06-11 10:18:12.407Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Volksfeste haben stets ihren eignen poetischen Reiz, sogar in unserm deutschen Norden, wo die verflachte Volksthümlichkeit der Poesie wohl am Meisten abgestorben ist.",
      "language": [],
      "musenalm_id": 64104,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Diamante. / Novelle",
      "pseudonym": true,
      "publication_statement": "",
      "responsibility_statement": "Bernd Guseck",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Diamante. / Novelle",
      "updated": "2009-05-15 00:00:00.000Z",
      "variant_title": "",
      "year": 1850,
      "editor": "",
      "agents": [
        {
          "annotation": "",
          "conjecture": false,
          "created": "2026-06-11 10:19:00.142Z",
