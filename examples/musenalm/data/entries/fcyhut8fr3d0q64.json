          "source_id": "qhnxtf9anllldje"
        }
      ],
      "source_id": "o4t5daiejmvzcjy"
    },
    {
      "annotation": "Dem Text vorangestellt: Ach, wenn du wieder siehst die grüne Au, / Dann tröste Gott dich, arme junge Frau. / Anette Droste-Hülshof",
      "content_type": [],
      "created": "2026-06-11 10:18:13.596Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "128",
      "incipit_statement": "Es war Samstag Abend. Obwohl tief im Sommer, wehte es doch kühl herüber vom See. Die Berge warfen ihre dunkelblauen Schatten über die Wieshalde,",
      "language": [],
      "musenalm_id": 64105,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Geretteten. / Eine Erzählung",
      "pseudonym": true,
      "publication_statement": "",
      "responsibility_statement": "Fr. Hilarius",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Geretteten. / Eine Erzählung",
      "updated": "2009-05-15 00:00:00.000Z",
      "variant_title": "",
      "year": 1850,
      "editor": "",
      "agents": [
        {
          "annotation": "",
          "conjecture": false,
          "created": "2026-06-11 10:19:00.237Z",
          "edit_comment": "",
          "type": "Autor:in",
          "uncertain": false,
          "updated": "2026-06-11 10:19:00.237Z",
          "agent": "euexsjcr9ar4su1",
          "source_id": "uitb8996ziznn1x"
        }
      ],
      "source_id": "dsqg0oi2tnwfcfs"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:13.597Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "214",
      "incipit_statement": "Stricken Sie doch, lieber Walpurg, sagte die polnische Gräfin Helmina zu dem in der andern Ecke des Sopha's sitzenden jungen Manne,",
      "language": [],
      "musenalm_id": 64106,
      "musenalm_pagination": [
