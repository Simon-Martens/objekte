      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "XI. / Die Natur der Eiche",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "XI. / Die Natur der Eiche",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "xyovvxj8p6jiq7s"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.066Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "129",
      "incipit_statement": "Dem im vorigen Jahrgange des Taschenbuches enthaltenen Aufsatze über das Entstehen von Pflanzen ohne Auslegung des Samenkornes,",
      "language": [],
      "musenalm_id": 108906,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "XII. / Das freiwillige Entstehen der / Pflanzen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "XII. / Das freiwillige Entstehen der / Pflanzen",
      "updated": "2015-10-05 00:00:00.000Z",
