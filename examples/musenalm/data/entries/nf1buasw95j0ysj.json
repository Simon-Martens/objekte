      "editor": "",
      "agents": [],
      "source_id": "e4f4ecqaind5bvx"
    },
    {
      "annotation": "G-Verz. s. Titelkupfer INr 108891, Obj 2",
      "content_type": [],
      "created": "2026-06-11 10:18:38.747Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "6",
      "incipit_statement": "Der auf solchem abgebildete colossale Baum ist eine Esche, welche, wie der beigefügte Maßstab ergiebt, in der Höhe von über 100 Fuß und einer Zweigausbreitung von mehr als 80 Fuß Braunschweigisch sich präsentirt.",
      "language": [],
      "musenalm_id": 108894,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Erklärung des Titelkupfers",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Erklärung des Titelkupfers",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "qg9gf9qr55ztddk"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:36.503Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Endlich rührt sich's doch mal wieder in den Regierungen und Nationalversammlungen in Betreff Wiederherbeiführungen besserer jagdlicher Zustände,",
      "language": [],
      "musenalm_id": 108895,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Die Jagd im Allgemeinen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Die Jagd im Allgemeinen",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "th9779ebdi4nfw6"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.064Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "17",
      "incipit_statement": "Noch in der Mitte des vorigen Jahrhunderts, und in manchen Staaten noch bis zu Anfang des gegenwärtigen, standen an den Wegen bei deren Eingange in den Wald, Pfähle mit goldenen Blechen,",
      "language": [],
      "musenalm_id": 108896,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. / Jagdstrafen der Vorzeit",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. / Jagdstrafen der Vorzeit",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "703cvbd7g2ln6ci"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "19",
      "incipit_statement": "Wer von Ihnen, meine geliebten Fachgenossen, sollte, wollte, wenn er einen Forst bewirthschaftet, oder den Betrieb darin einrichtet, nicht schon auf den betrübenden Gedanken gestoßen sein,",
      "language": [],
      "musenalm_id": 108897,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "III. / Führung des Lagerbuches, / Gendenkbuches, des forstwirth- / schaftlichen Album's",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "III. / Führung des Lagerbuches, / Gendenkbuches, des forstwirth- / schaftlichen Album's",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "aghrum6ix4qkzv4"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "28",
      "incipit_statement": "Wenngleich schon mehrfach in den frühern Jahrgängen unseres Taschenbuches gegen die Entfernung der Laubdecke vom Boden des Waldes gesprochen wurde,",
      "language": [],
      "musenalm_id": 108898,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "IV. / Die Laubnutzung",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "IV. / Die Laubnutzung",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "qb6y2v7uxdu0kgs"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "32",
      "incipit_statement": "Der Revierförster Rakebrand zu Wangelstedt im Herzogthum Braunschweig steht eines Abends am Schlusse des Monates August 1851 nach Hochwild auf dem Anstande,",
      "language": [],
      "musenalm_id": 108899,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "V. / Ein gewiß merkwürdiges Be- / gegniß mit einem Fuchse",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "V. / Ein gewiß merkwürdiges Be- / gegniß mit einem Fuchse",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "kbgb7amaaopks4m"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "34",
      "incipit_statement": "Daß der Wald im angemessenen Vorkommen schon bloß allein hinsichts Befriedigung des Holzbedürfnisses für alle mehr kalt belegene Länder durchaus unumgänglich nothwendig erscheint,",
      "language": [],
      "musenalm_id": 108900,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "VI. / Das Forstwesen, wie's besteht / in der Gegenwart",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "VI. / Das Forstwesen, wie's besteht / in der Gegenwart",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "ix5r35mdacl0r5o"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "95",
      "incipit_statement": "Auf einer Treibjagd nach Hasen und Füchsen im jungen Niederwalde sieht der braunschweigische Referendar Oehns schon von Weitem, wo einige Lücken sich zeigen,",
      "language": [],
      "musenalm_id": 108901,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "VII. / Fehlgeschossen und doch ge- / troffen!",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "VII. / Fehlgeschossen und doch ge- / troffen!",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "zl5f2eewjm91ke8"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "97",
      "incipit_statement": "In neuester Zeit hat der Eichenschälwald recht oft Erwähnung gefunden durch die Presse.",
      "language": [],
      "musenalm_id": 108902,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "VIII. / Der Eichenschälwald",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "VIII. / Der Eichenschälwald",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "x11ed90s0b7gtjf"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "111",
      "incipit_statement": "Es haben manche Forstwirthe die Gewohnheit, von den angekeimten Eicheln den Wurzelkeim abzuschneiden,",
      "language": [],
      "musenalm_id": 108903,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "IX. / Das Abschneiden der Wurzelkeime von den angekeimten Eicheln",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "IX. / Das Abschneiden der Wurzelkeime von den angekeimten Eicheln",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "fw81kdgjmoc8esf"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "118",
      "incipit_statement": "Auf einem Treibjagen im Hilsgebirge, Herzogthum Braunschweig, schießt der Oberförster v. S. einen Fuchs.",
      "language": [],
      "musenalm_id": 108904,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "X. / Es ist nicht Alles todt, was so erscheint",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "X. / Es ist nicht Alles todt, was so erscheint",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1855,
      "editor": "",
      "agents": [],
      "source_id": "7ptd4cop14j3e41"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.065Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "120",
      "incipit_statement": "Mehr und mehr gewinnt die deutsche Eiche an Wichtigkeit für uns Deutsche.",
      "language": [],
      "musenalm_id": 108905,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
