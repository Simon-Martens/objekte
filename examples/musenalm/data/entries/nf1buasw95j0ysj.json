    {
      "annotation": "Vorwort des Herausgebers",
      "content_type": [],
      "created": "2026-06-11 10:18:38.747Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Wenngleich das Taschenbuch für Natur- Forst- und Jagdfreunde nicht ausschließlich bloß den Mittheilungen über jagdliche Begebenheiten gewidmet ist,",
      "language": [],
      "musenalm_id": 108893,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Vorwort",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Vorwort",
      "updated": "2015-10-05 00:00:00.000Z",
      "variant_title": "",
