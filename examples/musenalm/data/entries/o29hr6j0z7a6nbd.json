      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "29",
      "incipit_statement": "Wir, Beelzebub, von Gottes Zorn, König der Hölle; Fürst der finsterniß; allzeit Mehrer des Reichs der Torheit,",
      "language": [],
      "musenalm_id": 112270,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
