    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.743Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "110",
      "incipit_statement": "Jugend hat keine Tugend! pflegen die lieben Alten, nicht selten mit Rücksicht auf ihre frühen Lebensjahre, zu sagen,",
      "language": [],
      "musenalm_id": 112274,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "IV. / Lebenslauf eines schönen Geistes in Wien. / Jugend hat keine Tugend",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "IV. / Lebenslauf eines schönen Geistes in Wien. / Jugend hat keine Tugend",
      "updated": "2012-11-06 00:00:00.000Z",
