      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Beelzebub mppr.",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Beelzebubs gnädiges Handschreiben an den / Wandsbecker Boten",
      "updated": "2012-11-06 00:00:00.000Z",
