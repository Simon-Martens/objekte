    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:37.637Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "147",
      "incipit_statement": "Meine Jolanthe schlenderte, an einem heitern Sommermorgen, auf der letzten Viertelmeile von ** nach Berlin so kopfhängerisch mit mir einher, als ob wir geraden Weges von Herrenhuth kämen",
      "language": [],
      "musenalm_id": 112275,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "V. / EinTag in Berlin. / Aus der Brieftasche eines Reisenden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "V. / EinTag in Berlin. / Aus der Brieftasche eines Reisenden",
      "updated": "2012-11-06 00:00:00.000Z",
