    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:41.743Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "81",
      "incipit_statement": "Was ich hier unter der eben bemerkten Rubrik mittheilen werde, ist größtentheils wörtlich aus einem kanonischen Buche der heiligen Schrift entlehnt",
      "language": [],
      "musenalm_id": 112273,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
