      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "81",
      "incipit_statement": "Es hat dir gefallen, mich in einem zu Anfang dieses Jahres erschienen Wische, betiltelt Urians Nachricht von der neuen Aufklärung, als einen erzdummen Teufel an den Pranger zu stellen",
      "language": [],
      "musenalm_id": 112272,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Urians Fehdebrief an den Wandsbecker / Bothen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Urian, seiner satanischen Majestät Oberhof-Ofenheizer",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Urians Fehdebrief an den Wandsbecker / Bothen",
      "updated": "2012-11-06 00:00:00.000Z",
      "variant_title": "",
      "year": 1798,
      "editor": "",
      "agents": [],
      "source_id": "cykqur2e44yk0yc"
