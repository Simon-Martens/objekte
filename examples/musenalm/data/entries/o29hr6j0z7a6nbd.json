      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Euer gnädiger Beelzebub",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Instruction für Asmus ( auch dessen Bundes- / genossen in Gießen, Marburg, Eisenach, Ful- / da, Frankfurt angehend)",
