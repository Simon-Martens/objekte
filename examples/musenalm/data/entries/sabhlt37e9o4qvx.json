      "content_type": [],
      "created": "2026-10-15 10:05:10.221Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "30",
      "incipit_statement": "Es giebt keine Thorheit in der Welt, von der die Einsiedler und Mönche der erstern christlichen Jahrhunderte nicht Gebrauch gemacht hatten.",
      "language": [],
      "musenalm_id": 140727,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die lebendige Statue",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die lebendige Statue",
      "updated": "2026-10-15 10:06:40.338Z",
