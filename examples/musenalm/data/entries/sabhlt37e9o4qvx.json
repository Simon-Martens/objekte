      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Diese Bogen scheinen den Titel nach zwar für Tollhäusler geschrieben zu seyn; daß aber der Verfasser derselben nur jene zu Tollhäuslern zählet, welche immer in den Legenden der Heiligen herumwühlen,",
      "language": [],
      "musenalm_id": 140723,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
