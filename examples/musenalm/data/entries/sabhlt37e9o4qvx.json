      "created": "2026-10-20 08:31:48.411Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "58",
      "incipit_statement": "Dieß behauptet wenigstens die Legende, welche von dem heiligen Gutlakus erzählet:",
      "language": [],
      "musenalm_id": 140737,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Wer ein Soldat wird, der wird schlech- / terdings des Teufels",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Wer ein Soldat wird, der wird schlech- / terdings des Teufels",
