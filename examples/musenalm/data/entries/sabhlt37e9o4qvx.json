    {
      "annotation": "",
      "content_type": [],
      "created": "2026-10-15 10:01:04.970Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "21",
      "incipit_statement": "Einem vernünftigen Menschen wird es schwerlich beyfallen, sich freywillig so zu betragen, daß er seiner tollen Streiche wegen in's Tollhaus gesteckt zu werden verdient.",
      "language": [],
      "musenalm_id": 140725,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Wie man es anzugehn hat, sich in / kurzer Zeit des Tollhauses würdig / zu machen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Wie man es anzugehn hat, sich in / kurzer Zeit des Tollhauses würdig / zu machen",
      "updated": "2026-10-20 10:03:50.728Z",
      "variant_title": "",
      "year": 1808,
      "editor": "gpj6tpa1lmk3vpy",
      "agents": [],
      "source_id": "q8ye511mkbp4ii7"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-10-15 10:03:34.582Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "27",
      "incipit_statement": "Von dem heiligen seraphischen Franz sagt die Legende, daß er einst eine ganze Scharr von allerley Vögeln herbeygelocket,",
      "language": [],
      "musenalm_id": 140726,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Zwey lächerliche Wortverschwender",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Zwey lächerliche Wortverschwender",
