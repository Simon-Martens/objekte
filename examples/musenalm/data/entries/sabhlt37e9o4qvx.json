      "musenalm_id": 140733,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Teufels-Martyrer",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Teufels-Martyrer",
      "updated": "2026-10-20 08:22:36.552Z",
