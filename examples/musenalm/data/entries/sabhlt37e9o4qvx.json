    {
      "annotation": "<div>Pabst Clemens der XIVte in / seiner Rede über den Aberglau- / ben und von der Religion</div>",
      "content_type": [],
      "created": "2026-10-15 09:24:46.179Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Je heiliger und wahrer die Religion ist, desto mehr fordert sie, daß man den Gläubigen in Ansehung dessen, was zum Aberglauben gehört, ihren Irrthum benehme.",
      "language": [],
      "musenalm_id": 140722,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Je heiliger und wahrer die Religion ist, desto mehr fordert sie, daß man den Gläubigen in Ansehung dessen, was zum Aberglauben gehört, ihren Irrthum benehme.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Pabst Clemens der XIVte",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "",
