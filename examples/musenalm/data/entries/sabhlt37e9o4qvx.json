      "content_type": [],
      "created": "2026-10-20 08:23:07.273Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "50",
      "incipit_statement": "Die Legendenschreiber wissen sogar Untugenden und Laster zu Tugenden und Gott wohlgefälligen Werken zu erheben,",
      "language": [],
      "musenalm_id": 140734,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Faulenzen ist Gott wohlgefälliger, / als das Arbeiten",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Faulenzen ist Gott wohlgefälliger, / als das Arbeiten",
      "updated": "2026-10-20 08:26:07.125Z",
      "variant_title": "",
      "year": 1808,
      "editor": "gpj6tpa1lmk3vpy",
      "agents": [],
      "source_id": "ekhf8nwlrr5mccj"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-10-20 08:26:28.651Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "53",
      "incipit_statement": "Da die heilige Rosa von Viterbo einst ihre Schürze voll Stückchen Brods den Armen zutragen wollte, begegnete ihr der Vater unter der Thüre und fragte sie: was sie in der Schürze habe?",
      "language": [],
      "musenalm_id": 140735,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Lügen und Stehlen macht Heilige",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Lügen und Stehlen macht Heilige",
      "updated": "2026-10-20 08:28:32.649Z",
      "variant_title": "",
      "year": 1808,
      "editor": "gpj6tpa1lmk3vpy",
      "agents": [],
      "source_id": "3u1y9ur5x284xpg"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-10-20 08:28:53.297Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "56",
      "incipit_statement": "Einige junge Mädchen badeten einst nackt in einem Brunnen, und im Angesichte des heiligen Jakobs Bischofs von Nissibi,",
      "language": [],
      "musenalm_id": 140736,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die badenden Mädchen, und deren son- / derbare Verwandlung",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die badenden Mädchen, und deren son- / derbare Verwandlung",
      "updated": "2026-10-20 08:31:17.250Z",
      "variant_title": "",
      "year": 1808,
      "editor": "gpj6tpa1lmk3vpy",
      "agents": [],
