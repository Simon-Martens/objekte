      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Nach einer langweiligen frostigen Herbstnacht brach der heitere Morgen der deutschen Posie wieder an, erquickende Tage und gedeihliche Wärme herbeiführend.",
      "language": [],
      "musenalm_id": 73663,
