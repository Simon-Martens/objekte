      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Geschichte / der / Krönungsstadt Presburg",
      "updated": "2017-07-21 00:00:00.000Z",
      "variant_title": "",
      "year": 1830,
      "editor": "",
      "agents": [],
      "source_id": "k3i5grdhdry9zdd"
    },
