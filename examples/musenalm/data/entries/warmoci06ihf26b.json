      "created": "2026-06-11 10:18:29.435Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "56",
      "incipit_statement": "Die Weisheit ist sanft, nachsichtig, mäßig, geduldig, mitleidig, Freundinn der Freiheit, die sich selbst und ihren Verehrern jedes schuldlose Vergnügen gestattet,",
      "language": [],
      "musenalm_id": 89092,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Weisheit auf der Wanderschaft. / Eine Nachahmung des Platon",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Weisheit auf der Wanderschaft. / Eine Nachahmung des Platon",
      "updated": "2013-05-03 00:00:00.000Z",
