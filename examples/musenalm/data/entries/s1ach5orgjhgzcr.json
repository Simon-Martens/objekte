    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:23.344Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "28",
      "incipit_statement": "Unser Kandide war ein herzensguter Junge, aber von anderer Art als jener, welcher sich in die schöne Kunigunde von Thunder-ten-tronckh verliebte, dafür lebte er um dreißig Jahrhunderte fürher und vierhundert Meilen weit vom Westphälinger Lande.",
      "language": [],
      "musenalm_id": 75930,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Kandide der zweite / oder / der Freund der Wahrheit",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Kandide der zweite / oder / der Freund der Wahrheit",
      "updated": "2010-02-19 00:00:00.000Z",
