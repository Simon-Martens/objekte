      "source_id": "ix2qu2gmfh8237k"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:23.344Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "91",
      "incipit_statement": "Ich suche mich zu vergnügen, in welcher Gesellschaft es auch sei. Der Witz im zerlumpten Kleide gefällt mir nicht minder.",
