    {
      "annotation": "mit Vignette über dem Beitrag; s. Photo",
      "content_type": [],
      "created": "2026-06-11 10:18:37.631Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "Seitwärts ziehn die Treiber hinab. - Mit prüfendem / Auge / wählet der Förster die Ständ' und seinem Winke ge- / horsam / stellen die Schützen sich an.",
      "language": [],
      "musenalm_id": 108816,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
