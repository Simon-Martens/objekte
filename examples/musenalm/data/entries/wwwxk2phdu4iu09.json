      "subtitle_statement": "",
      "title_statement": "Januar - Kreisemonat",
      "updated": "2014-01-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1839,
      "editor": "",
      "agents": [],
      "source_id": "8nmobou4lp4sw0g"
    },
    {
      "annotation": "mit Vignette über dem Beitrag; s. Photo",
      "content_type": [],
      "created": "2026-06-11 10:18:37.633Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Zur Feier der Sylvesternacht hatten sich Fluren und Wälder in reichen Silberstoff gekleidet und über den See ward flugs ein silberner Estrich gebreitet,",
      "language": [],
      "musenalm_id": 108817,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Februar - Rollemonat",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [
        "alm_4085_108817_1zx9aswqzr.jpg"
      ],
      "subtitle_statement": "",
      "title_statement": "Februar - Rollemonat",
      "updated": "2014-01-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1839,
      "editor": "",
      "agents": [],
      "source_id": "2nzix22bwf6z08v"
    },
    {
      "annotation": "mit Vignette über dem Beitrag; s. Photo",
      "content_type": [],
      "created": "2026-06-11 10:18:40.491Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Und wenn der Abendhauch schon mehr erwärmt, / Des Waldes Stimmen weh'n, so eilt er hin",
      "language": [],
      "musenalm_id": 108818,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "März - Schnepfenmonat",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [
        "alm_4085_108818_fhk5blb2yc.jpg"
      ],
      "subtitle_statement": "",
      "title_statement": "März - Schnepfenmonat",
      "updated": "2014-01-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1839,
      "editor": "",
      "agents": [],
      "source_id": "gpwyfdjzdc3xdkl"
    },
    {
      "annotation": "mit Vignette über dem Beitrag; s. Photo",
      "content_type": [],
      "created": "2026-06-11 10:18:40.494Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Dem Jäger aber, der an Wäldern wohnt, / Entlegen den Behausungen der Menschen,",
      "language": [],
      "musenalm_id": 108819,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "April - Balzmonat",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [
        "alm_4085_108819_evkbwlvoks.jpg"
      ],
      "subtitle_statement": "",
      "title_statement": "April - Balzmonat",
      "updated": "2014-01-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1839,
      "editor": "",
      "agents": [],
      "source_id": "o612m10slbozc3g"
    },
    {
      "annotation": "mit Vignette über dem Beitrag; s. Photo",
      "content_type": [],
      "created": "2026-06-11 10:18:40.499Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Nun ruhen alle Wälder! hören wir den rüstigen Waidmann in christlicher Ergebung ausrufen,",
      "language": [],
      "musenalm_id": 108820,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Mai - Setzmonat",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [
        "alm_4085_108820_m4ry5k131h.jpg"
      ],
      "subtitle_statement": "",
      "title_statement": "Mai - Setzmonat",
      "updated": "2014-01-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1839,
      "editor": "",
      "agents": [],
      "source_id": "wsyvpn2vb6gyyjr"
    },
    {
