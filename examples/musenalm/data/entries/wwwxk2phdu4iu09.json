      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Saat und Pflanzung bestellte in reichlicher Maaße / Auf des Waldgott's Geheiß, kundig der sorgliche Förster,",
      "language": [],
      "musenalm_id": 108821,
      "musenalm_pagination": [],
