    {
      "annotation": "Anm. am Objekt: Die Veranlassung zu diesen Stanzen gab ein treffliches Bild, das in der Sammlung der Herren Boisserée und Bertram einen engen Freundeskreis allgemein angesprochen hatte, und in diesem auf mannichfache Art verfielfältigt wurde, so wie in dem Titelkupfer zum erstenmal gestochen erscheint. /) s. Titelgraphik INr 72863, Obj 3",
      "content_type": [],
      "created": "2026-06-11 10:18:19.959Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Schaut dieses Bild voll Reiz und Freundlichkeit, / In Lieb' und Ernst voll Frömmigkeit und Milde;",
      "language": [],
      "musenalm_id": 72868,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Stiftungsbrief / den Freunden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Stiftungsbrief / den Freunden",
      "updated": "2010-02-15 00:00:00.000Z",
      "variant_title": "",
      "year": 1812,
      "editor": "",
      "agents": [],
      "source_id": "v8d6scekql9083g"
    },
