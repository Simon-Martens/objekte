      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Der Scheihk von Alessandria, Ali Banu, war ein sonderbarer Mann; wenn er Morgens durch die Straßen der Stadt ging, angethan mit einem Turban aus den köstlichsten Cachemirs gewunden,",
      "language": [],
      "musenalm_id": 41642,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
