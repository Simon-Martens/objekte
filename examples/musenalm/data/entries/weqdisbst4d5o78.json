    {
      "annotation": "# Bez. aus dem I-Verz",
      "content_type": [],
      "created": "2026-06-11 10:17:59.742Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "70",
      "incipit_statement": "Herr, ich bin aus Mogador, am Strande des großen Meers, und als der großmächtigste Kaiser Mulei-Ismael über Fetz und Marokko herrschte, hat sich die Geschichte zugetragen,",
      "language": [],
      "musenalm_id": 41644,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Abner, der Jude, der nichts gesehen hat",
      "pseudonym": true,
      "publication_statement": "",
      "responsibility_statement": "W. Hauff",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Abner, der Jude, der nichts gesehen hat",
      "updated": "2005-12-12 00:00:00.000Z",
      "variant_title": "",
      "year": 1827,
      "editor": "",
      "agents": [
        {
          "annotation": "",
          "conjecture": false,
          "created": "2026-06-11 10:18:59.117Z",
          "edit_comment": "",
          "type": "Autor:in",
