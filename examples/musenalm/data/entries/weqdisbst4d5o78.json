      "created": "2026-06-11 10:18:00.239Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "253",
      "incipit_statement": "Herr! Ich bin aus einem Lande, das weit gegen Mitternacht liegt, Norwegen genannt; wo die Sonne nicht, wie in deinem gesegneten Vaterlande, Feigen und Citronen kocht;",
      "language": [],
      "musenalm_id": 41649,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Fest der Unterirdischen. / (Norwegisches Mährchen nach mündlicher Ueberlieferung)",
      "pseudonym": true,
      "publication_statement": "",
      "responsibility_statement": "W. Grimm",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Fest der Unterirdischen. / (Norwegisches Mährchen nach mündlicher Ueberlieferung)",
