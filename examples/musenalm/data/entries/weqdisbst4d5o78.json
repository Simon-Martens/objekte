      "source_id": "yjzjexkojga89i5"
    },
    {
      "annotation": "# Bez. aus dem I-Verz",
      "content_type": [],
      "created": "2026-06-11 10:17:59.742Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "86",
      "incipit_statement": "Die rauchige Schwerdtfeger- und Schuhflickergasse meiner Vaterstadt lag wie in einem Hohlweg, fast unterirdisch zu nennen, krumm und eng unter den hohen, breiten Straßen der Hauptstadt",
      "language": [],
      "musenalm_id": 41645,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
