      "musenalm_id": 66130,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Auf / Erfahrung gegründete Vorschläge, / die Waldraupe / Nonne, / genannt, / Phalaena Bombyx Monacha, / zu vertilgen, / ihrer Vermehrung vorzubeugen und das / von ihr abgefressene Nadelholz vor / dem Absterben zu sichern",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Auf / Erfahrung gegründete Vorschläge, / die Waldraupe / Nonne, / genannt, / Phalaena Bombyx Monacha, / zu vertilgen, / ihrer Vermehrung vorzubeugen und das / von ihr abgefressene Nadelholz vor / dem Absterben zu sichern",
