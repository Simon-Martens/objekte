    {
      "annotation": "mit einer Illustration s. Titelportarit INr 116474, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:18:42.612Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Das Ansehen eines großen deutschen Mannes zu erneuern, zu einer Zeit, wo die Liebe für das Große und Edle und ein enthusiastisches Hingeben für erhabene Zwecke, nicht bloß ein Eigenthum des Auslandes seyn darf,",
      "language": [],
      "musenalm_id": 116477,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Charakteristik des Grafen / Wilhelm v. Lippe-Bückeburg",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Charakteristik des Grafen / Wilhelm v. Lippe-Bückeburg",
      "updated": "2010-01-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1805,
      "editor": "",
      "agents": [],
      "source_id": "6rwt4lhp38mlv4b"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:42.612Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "71",
      "incipit_statement": "Die Regierung Alexanders I., dessen Organisationsgeist sich mit Kenntniß und Energie über alle Theile der Staatsverwaltung verbreitet,",
      "language": [],
      "musenalm_id": 116478,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
