      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Über / den gegenwärtigen Etat / der russischen Armee",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Über / den gegenwärtigen Etat / der russischen Armee",
      "updated": "2010-01-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1805,
      "editor": "",
      "agents": [],
      "source_id": "gyuaf240esykh8i"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:42.612Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "83",
      "incipit_statement": "Die österreichische Regierung hat seit 3 Jahren eine Handlungsweise angenommen, welche in der Geschichte dieses Staates Epoche macht,",
      "language": [],
      "musenalm_id": 116479,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Über / die neue Organistaion / des / österreichischen Militärwesen / und / den gegenwärtigen Etat / der österreichischen Armeee",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Über / die neue Organistaion / des / österreichischen Militärwesen / und / den gegenwärtigen Etat / der österreichischen Armeee",
      "updated": "2010-01-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1805,
      "editor": "",
      "agents": [],
      "source_id": "b9cppjdbpwi2qj2"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:42.613Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "131",
      "incipit_statement": "Die kriegerischen Ereignisse des vergangenen Jahres, und die Revolution hatten alle Gemüther in innere Bewegung, in frohe oder bange Erwartung der Zukunft versetzt.",
      "language": [],
      "musenalm_id": 116480,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Übersicht / des / Feldzugs von 1793 / in den Niederlanden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
