    {
      "annotation": "Vorwort des Herausgeberes",
      "content_type": [],
      "created": "2026-06-11 10:18:53.390Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Ich konnte es von dem Geiste unsers Zeitalters nach dem in ihm herrschenden Enthusiasm für Verbreitung der reinen Religionslehre der Vernunft erwarten, dass man wenigstens meiner Idee, ein Taschenbuch für denkende Gottesbverehrer zu versuchen,",
      "language": [],
      "musenalm_id": 133127,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Vorrede / über / ein scheinbares Paradoxon: / Es ist in der Religionslehre der kri- / tischen Philosophie alles alt, und / alles neu",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "K. H. Heydenreich",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Vorrede / über / ein scheinbares Paradoxon: / Es ist in der Religionslehre der kri- / tischen Philosophie alles alt, und / alles neu",
      "updated": "2010-02-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1797,
      "editor": "",
      "agents": [
        {
          "annotation": "",
