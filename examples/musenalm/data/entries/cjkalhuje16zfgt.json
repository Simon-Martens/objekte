      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "88",
      "incipit_statement": "Der Geitz gehört unter diejenigen Laster, denen die Menschen die meiste Schonung angedeyhen lassen,",
      "language": [],
      "musenalm_id": 133138,
      "musenalm_pagination": [
