    },
    {
      "annotation": "Geistliche Reden, Andachten und Gedichte (Sammlung INr 133131, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:53.392Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "85",
      "incipit_statement": "Schweigt, ihr Sinne! diese heilge Stille, / wo mein Geist, entbunden seiner Hülle, / Sich der reinsten Seligkeit erfeut;",
      "language": [],
      "musenalm_id": 133137,
      "musenalm_pagination": [
