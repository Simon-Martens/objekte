    {
      "annotation": "Dem Text vorangestellt: Es ist Ordnung im Weltall; denn es ist Ordnung in unserm Herzen. Girard im Freunde der Natur",
      "content_type": [],
      "created": "2026-06-11 10:18:53.391Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "43",
      "incipit_statement": "Wenn die Idee der moralischen Ordnung der Welt eine nothwendige und für alle vernünftige freye Wesen gleich heilige Vorstellung ist, so dürfen wir voraussetzen, dass sie auch die gemeine Menschenvernunft in ihren Urtheilen über sittliche Verhältnisse",
      "language": [],
      "musenalm_id": 133128,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Ueber die / Ordnung / als / Basis / der Gotteslehre der Vernunft",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Ueber die / Ordnung / als / Basis / der Gotteslehre der Vernunft",
      "updated": "2010-02-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1797,
      "editor": "",
      "agents": [],
      "source_id": "v7oua7fol7po6iz"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:53.391Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Unter mehrern ungerechten Beschwerden, welche die Gegner der kritischen Philosophie über die Folgen ihrer Verbreitung führen, zeichnen sich besonders Klage über den nachtheiligen Einfluss aus, den ihre Religionslehre haben soll,",
      "language": [],
      "musenalm_id": 133130,
      "musenalm_pagination": [
        "1. Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Ideen / über / die Behandlung / der moralischen Gotteslehre / der / kritischen Philosophie / in Werken der geistlichen Redekunst",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Ideen / über / die Behandlung / der moralischen Gotteslehre / der / kritischen Philosophie / in Werken der geistlichen Redekunst",
      "updated": "2010-02-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1797,
      "editor": "",
      "agents": [],
      "source_id": "8vw09cknjak3st5"
    },
