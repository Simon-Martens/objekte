      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "104",
      "incipit_statement": "Die Gegenwart ist der einzige Zeitpunkt, von welchem wir sagen können, dass er unser ist,",
      "language": [],
      "musenalm_id": 133139,
      "musenalm_pagination": [
        "1. Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "VII. / Vergangenheit, Gegenwart, und / Zukunft, / eine moralisch-religiöse Betrachtung",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
