    {
      "annotation": "Geistliche Reden, Andachten und Gedichte (Sammlung INr 133131, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:53.391Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Der erhabene Gedanke, meine Brüder! den ein menschlicher Geist erreichen kann, ist wohl unstreitig ein Gedanke der Heiligkeit seines Gottes.",
      "language": [],
      "musenalm_id": 133132,
      "musenalm_pagination": [
        "1. Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Ueber die Heiligkeit Gottes, / eine geistliche Rede",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Ueber die Heiligkeit Gottes, / eine geistliche Rede",
      "updated": "2010-02-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1797,
      "editor": "",
      "agents": [],
      "source_id": "69e2d6tsb9dzmtw"
    },
    {
      "annotation": "Geistliche Reden, Andachten und Gedichte (Sammlung INr 133131, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:53.391Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "24",
      "incipit_statement": "Wer, meine Brüder, die hohe Würde der Religion zu fühlen weiss, wer von der Ueberzeugung durchdrungen ist, dass sie die schönsten Bande zwischen Gott und der Menschheit knüpft,",
      "language": [],
      "musenalm_id": 133133,
      "musenalm_pagination": [
        "1. Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. / Ueber die wahre  und falsche Fröm- / migkeit",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. / Ueber die wahre  und falsche Fröm- / migkeit",
      "updated": "2010-02-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1797,
      "editor": "",
      "agents": [],
      "source_id": "fkc3leunjfzrud6"
    },
    {
      "annotation": "Geistliche Reden, Andachten und Gedichte (Sammlung INr 133131, Obj 9) Übersetung des nachstehenden Gedichts von Le Brun",
      "content_type": [],
      "created": "2026-06-11 10:18:53.391Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "58",
      "incipit_statement": "O Geist, den auf so tausendfache Weise / Der Priester nennt, der Mensch verehrt, Blick auf ein Volk, vereint zu deinem Preise;",
      "language": [],
      "musenalm_id": 133134,
      "musenalm_pagination": [
        "1. Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "III. / Hymne",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Stampeel",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "III. / Hymne",
      "updated": "2010-02-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1797,
      "editor": "",
      "agents": [
