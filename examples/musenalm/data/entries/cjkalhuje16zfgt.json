      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "64",
      "incipit_statement": "Es ist ein niederschlagender Gedanke, dass nur äuserst wenige Menschen einer herzlichen Mitfeude über das Glück ihrer Mitmenschen fähig sind,",
      "language": [],
      "musenalm_id": 133136,
      "musenalm_pagination": [
        "1. Arabische Seitenzählung"
      ],
      "musenalm_type": [
