    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:42.004Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "167",
      "incipit_statement": "Die Rückwirkungen der glorreichen Pariser Februarrevolution auf unser Deutschland zeigten sich zuerst, wie natürlich, in den Grenzländern, vor Allem aber in Baden.",
      "language": [],
      "musenalm_id": 114704,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Baden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Baden",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "e8iqi4i19yi6k1l"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:42.004Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "180",
      "incipit_statement": "Auch in Hessen-Darmstadt waren die Kammern seit dem 17. December 1847 beisammen.",
      "language": [],
      "musenalm_id": 114705,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Hessen-Darmstadt",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Hessen-Darmstadt",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "9xm9lfrbvhec4bu"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:42.004Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "187",
      "incipit_statement": "Durch den am 5. Januar erfolgten Tod des jungen Erbprinzen Friedrich ist Aussicht vorhanden, daß die Linie Hessen-Homburg bald aussterben wird.",
      "language": [],
      "musenalm_id": 114706,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Hessen-Homburg",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Hessen-Homburg",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "4f6emdq95v9dvie"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:43.191Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "187",
      "incipit_statement": "In den früheren Jahrgängen unseres Taschenbuchs hatten wir von Hessen-Kassel von Nichts als Verboten, Amtsentsetzungen und andern dem alten Systeme eigenthümlichen politischen Maßregeln, zu berichten",
      "language": [],
      "musenalm_id": 114707,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Hessen-Kassel",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Hessen-Kassel",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "3ok9vcnaz75hgiu"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:43.191Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "194",
      "incipit_statement": "Auch die dem Frankfurter Staatsverbande Angehörigen verlangten von ihrem Senate, der sich früher, schon wegen der Nähe des Bundestages, nicht zu sehr durch Freisinnigkeit ausgezeichnet",
      "language": [],
      "musenalm_id": 114708,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Freie Stadt Frankfurt",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Freie Stadt Frankfurt",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "7kysw9s0msrb9xn"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:43.191Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "195",
      "incipit_statement": "Kräftig traten nach den Pariser Ereignissen auch die Nassauer auf. Am 2. März setzten sie ein Adresse auf und forderten darin ganz kategorisch",
      "language": [],
      "musenalm_id": 114709,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Nassau",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Nassau",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "svnn89qmyx1dmom"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:43.192Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "196",
      "incipit_statement": "In keinem Lande war wohl, mit Ausnahme von Kurhessen und etwa Hannover, die heftige Gährung, welche nach der Pariser Februarrevolution in allen deutschen Gauen nicht blos gegen die Ministerien, sondern auch gegen die Monarchen ausbrach, gerechtfertigter,",
      "language": [],
      "musenalm_id": 114710,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Baiern",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Baiern",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "gsxh2i7dw27dw7l"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:43.192Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "202",
      "incipit_statement": "In Würtemberg herrschte vor den Ereignissen in Frankreich schon seit längerer Zeit politische Windstille.",
      "language": [],
      "musenalm_id": 114711,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Würtemberg",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Würtemberg",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "rm06616zrxajzcd"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:43.192Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "208",
      "incipit_statement": "Auch die Bewohner von Hechingen und Sigmaringen haben ihre Revolution gehabt und zwar eine so stürmische, daß sie den resp. Fürsten bald die Herrschaft gekostet hätte,",
      "language": [],
      "musenalm_id": 114712,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Fürstenthümer Hohenzollern",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Fürstenthümer Hohenzollern",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "7dytmi0hmos37ao"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:43.192Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "209",
      "incipit_statement": "In Norddeutschland ging die Bewegung von Sachsen und in diesem Lande wieder in Leipzig aus.",
      "language": [],
      "musenalm_id": 114713,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Sachsen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Sachsen",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "etnap9cyehr5zqm"
    },
    {
      "annotation": "Dritter Abschnitt: Die einzelnen deutschen Staaten (Sammlung INr 1147003, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:43.192Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "220",
      "incipit_statement": "Auch in Weimar war von Seiten der Regierung gegründete Ursache zur Beschwerde gegeben worden.",
      "language": [],
      "musenalm_id": 114714,
      "musenalm_pagination": [
