    {
      "annotation": "Die Geschichte der außerdeutschen Staaten (Sammlung INr 114699, Obj 3)",
      "content_type": [],
      "created": "2026-06-11 10:18:42.004Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "74",
      "incipit_statement": "Es war ein großes Glück für den König von Belgien, daß er im August v. Jahres nach langem Zögern endlich sich entschlossen hatte, den Wünschen der Mehrheit der Belgier gerecht zu werden,",
      "language": [],
      "musenalm_id": 114701,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Belgien. - Großbritannien u. Irland. - / Die Schweiz. - Italien. - / Dänemark",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Belgien. - Großbritannien u. Irland. - / Die Schweiz. - Italien. - / Dänemark",
      "updated": "2016-11-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "btdo5vgwlaf8a3h"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:42.004Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "115",
      "incipit_statement": "Welch' ein gewaltiger Abstand zwischen den Zuständen von Heute und der Zeit zu Beginn dieses Jahres! Damals glaubten die Mächtigen der Erde, fester als je auf ihren Thronen zu sitzen",
      "language": [],
      "musenalm_id": 114702,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
