      "variant_title": "",
      "year": 1848,
      "editor": "",
      "agents": [],
      "source_id": "9h2wr2fdzv87fn6"
    },
    {
      "annotation": "Reihenfolge und Erklärung der Stahlstiche (Sammlung INr 64037, Obj 4) s. Graphik Nr 64045, Obj 12",
      "content_type": [],
      "created": "2026-06-11 10:18:14.398Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Wie wunderherrlich Feld und Flur sich schmücken! / Und doppelt schön erscheint's dem armen Kinde,",
      "language": [],
      "musenalm_id": 64040,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "III. Spazierfahrt. / (Aus den Geheimnissen von Paris.)",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "III. Spazierfahrt. / (Aus den Geheimnissen von Paris.)",
      "updated": "2009-05-14 00:00:00.000Z",
      "variant_title": "",
      "year": 1848,
      "editor": "",
      "agents": [],
      "source_id": "b88r91sveonwhj0"
    },
    {
      "annotation": "Reihenfolge und Erklärung der Stahlstiche (Sammlung INr 64037, Obj 4) s. Graphik Nr 64046, Obj 13",
      "content_type": [],
      "created": "2026-06-11 10:18:14.398Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "O Vater, seufzt Marie, muß denn die Schande / So unaufloschbar in die Seele brennen!",
      "language": [],
      "musenalm_id": 64041,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "IV. Der Pfarrer von Bonqueval. / (Aus den Geheimnissen von Paris)",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "IV. Der Pfarrer von Bonqueval. / (Aus den Geheimnissen von Paris)",
      "updated": "2009-05-14 00:00:00.000Z",
      "variant_title": "",
      "year": 1848,
      "editor": "",
      "agents": [],
      "source_id": "55uxkmblc22jzbc"
    },
    {
      "annotation": "Reihenfolge und Erklärung der Stahlstiche (Sammlung INr 64037, Obj 4) s. Graphik Nr 64047, Obj 14",
      "content_type": [],
      "created": "2026-06-11 10:18:14.398Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Wenn sie den Mann umlagern, die Gefahren, / Und den umrung'nen drohen zu verschlingen,",
      "language": [],
      "musenalm_id": 64042,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "V. Daniel in der Löwengrube",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "V. Daniel in der Löwengrube",
      "updated": "2009-05-14 00:00:00.000Z",
      "variant_title": "",
