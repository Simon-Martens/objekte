      "agents": [],
      "source_id": "vg0qu6eit0s4q3e"
    },
    {
      "annotation": "Reihenfolge und Erklärung der Stahlstiche (Sammlung INr 64037, Obj 4) s. gest. Titel INr 64035, Obj 2",
      "content_type": [],
      "created": "2026-06-11 10:18:14.398Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Das deutsche Weib, - o Wort von süßem Tone! / Die Jungfrau hier in ihrer Anmuth Blüthe,",
      "language": [],
      "musenalm_id": 64039,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. Zum Titelblatt",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. Zum Titelblatt",
