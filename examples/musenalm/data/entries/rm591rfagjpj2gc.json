    {
      "annotation": "Reihenfolge und Erklärung der Stahlstiche (Sammlung INr 64037, Obj 4) s. Titelgraphik INr 64034, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:18:14.398Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "O wie verschönt ein heitrer Sinn das Leben! / Das Mädchen seht, mit kargem Loos zufrieden,",
      "language": [],
      "musenalm_id": 64038,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
