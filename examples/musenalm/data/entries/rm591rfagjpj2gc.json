      "source_id": "lme2goi93z1ud0o"
    },
    {
      "annotation": "Reihenfolge und Erklärung der Stahlstiche (Sammlung INr 64037, Obj 4) s. Graphik Nr 64048, Obj 15",
      "content_type": [],
      "created": "2026-06-11 10:18:14.398Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Das eben ist der Wahrheit hoher Segen, / Die Kraft des Lichtes und der echten Lehre,",
      "language": [],
      "musenalm_id": 64043,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "VI. Christus im Tempel",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "VI. Christus im Tempel",
      "updated": "2009-05-14 00:00:00.000Z",
      "variant_title": "",
      "year": 1848,
      "editor": "",
      "agents": [],
      "source_id": "rrdspfwonoe1g58"
