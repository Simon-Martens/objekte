      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. Rigolette. / ( Aus den Geheimnissen von Paris.)",
      "updated": "2009-05-14 00:00:00.000Z",
