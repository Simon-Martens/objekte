    {
      "annotation": "s. beigegebenes Gedicht INr 119117, Obj 7",
      "content_type": [],
      "created": "2026-06-11 10:18:44.620Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "30",
      "incipit_statement": "Arm und reich begegnen sich, schuf doch beide Gott der Herr. In diesem echt biblische Lebensweisheit einschließenden Sprichwort, ist in reichster Fülle das Material geboten.",
      "language": [],
      "musenalm_id": 119176,
      "musenalm_pagination": [
