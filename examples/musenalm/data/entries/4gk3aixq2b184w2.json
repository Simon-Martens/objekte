    {
      "annotation": "Erklärung der Kupfer (Sammlung INr 65356, Obj 4) s. Titelgraphik INr 65353, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:18:10.604Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Als Titelkupfer ist mit Bezugnahme auf die bildliche Darstellung des diesjährigen Taschenbuchs der Phantasus, nach eigner Idee des Hrn. Hofmaler W. Hensel, der auch die übrigen Zeichungen geliefert hat, dargestellt.",
      "language": [],
      "musenalm_id": 65357,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Als Titelkupfer ist mit Bezugnahme auf die bildliche Darstellung des diesjährigen Taschenbuchs der Phantasus, nach eigner Idee des Hrn. Hofmaler W. Hensel, der auch die übrigen Zeichungen geliefert hat, dargestellt.…",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
