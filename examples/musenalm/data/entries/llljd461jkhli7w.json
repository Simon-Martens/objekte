      "created": "2026-06-11 10:18:53.932Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "90",
      "incipit_statement": "Scheiden - scheiden, wie unendlich thut es doch weh! wie beengt es das trauernde herz,",
      "language": [],
      "musenalm_id": 134345,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Grabesblume",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Dr. X. F. Nowotny",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Grabesblume",
