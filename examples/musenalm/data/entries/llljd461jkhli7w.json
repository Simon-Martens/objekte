      "source_id": "36ilv917yj1hdus"
    },
    {
      "annotation": "$ bez. Titelgraphik fehlt",
      "content_type": [],
      "created": "2026-06-11 10:18:53.944Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "17",
      "incipit_statement": "Worte säuseln, Rosen duften / Durch die kühle Dämmerung, / Wie ein Falter nimmt die Sehnsucht / Auf zum Himmel ihren Schwung.",
      "language": [],
      "musenalm_id": 134349,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Vom Balkone. / (Zum Titelkupfer.)",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Vom Balkone. / (Zum Titelkupfer.)",
      "updated": "2021-10-12 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
