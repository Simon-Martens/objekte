      "source_id": "w2g90496rvybv1v"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:53.932Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "53",
      "incipit_statement": "Sie wissen ja für alles Rath, lieber Sorgenfrei sprach die Räthin Albani, Sie wissen ja für alles Rath - also rathen Sie mir, wen ich zum Klaviermeister meines Sohnes erwähle,",
      "language": [],
      "musenalm_id": 134343,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Wider Willen. / Novelle",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "J. F. Lyser",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Wider Willen. / Novelle",
      "updated": "2021-10-12 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "mfyxxhftuj2goc4"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:53.932Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "74",
      "incipit_statement": "Mächtig über alle Gebirge im Westen des Sonnthales erheben sich die Sulzbacher Alpen, nicht mit Unrecht die untersteierische Schweiz genannt.",
      "language": [],
      "musenalm_id": 134344,
      "musenalm_pagination": [
