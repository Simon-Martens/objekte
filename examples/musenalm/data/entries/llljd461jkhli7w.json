    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:53.933Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "134",
      "incipit_statement": "Des Liebsten Bild am Herzen, / O süß Erinnreungspfand, In einer schönen Stunde, / Gereicht von treuer Hand!",
      "language": [],
      "musenalm_id": 134351,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
