      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Die schöne und reiche Gräfin Eveline saß vor dem Toilettenspiegel. Ihr Kopf war unter den Händen ihrer Freundin Clothilde, die mit Eifer daran ordnete, strich und glättete.",
      "language": [],
      "musenalm_id": 134342,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der Opfertod. / Novelle",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Friedrich Dornau",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der Opfertod. / Novelle",
      "updated": "2021-10-12 00:00:00.000Z",
      "variant_title": "",
