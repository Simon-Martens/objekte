      "source_id": "482s4nnbbcetu8o"
    },
    {
      "annotation": "Das Mahlerisch-Schöne der Italiänischen Schweitz. Aus dem Manuscript eines Reisenden vom J. 178[?] (Sammlung INr 50849, Obj 16)",
      "content_type": [],
      "created": "2026-06-11 10:17:41.773Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "24",
      "incipit_statement": "Jetzt standen wir am Ufer, blickten die Felsen,das tobende Wasser und den Himmel an.",
      "language": [],
      "musenalm_id": 50853,
      "musenalm_pagination": [
        "1. Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
