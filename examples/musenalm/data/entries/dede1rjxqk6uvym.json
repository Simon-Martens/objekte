      "source_id": "xagn2e0o6deplff"
    },
    {
      "annotation": "Das Mahlerisch-Schöne der Italiänischen Schweitz. Aus dem Manuscript eines Reisenden vom J. 178[?] (Sammlung INr 50849, Obj 16)",
      "content_type": [],
      "created": "2026-06-11 10:17:41.287Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "32",
      "incipit_statement": "Wir hatten in Como weiter nichts zu thun, als gleich nach Tische ein Schff zu besteigen und zu Wasser die Reise nach La Riva zu beginnen.",
      "language": [],
      "musenalm_id": 50855,
      "musenalm_pagination": [
