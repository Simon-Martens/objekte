      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Sklavin",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Sklavin",
