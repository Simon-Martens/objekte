      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Das alte Carthago war zu seiner Zeit die erste Stadt der Welt an Pracht und Macht, Üppigkeit und Reichthum; jetzt weiß man die Stelle nicht mehr gewiß, wo sie gestanden hat.",
      "language": [],
      "musenalm_id": 129619,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
