    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.369Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "115",
      "incipit_statement": "Ich empfand, daß ich sterbe. Der Leib wollte den Geist nicht lassen. Große Schmerzen litt ich; große Angst hatte mich überfallen.",
      "language": [],
      "musenalm_id": 129627,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
