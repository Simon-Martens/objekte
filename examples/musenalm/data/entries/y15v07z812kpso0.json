    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.369Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "112",
      "incipit_statement": "Im Garten saß ich, / Zwölf Jahre zählt' ich kaum, / Und Blüte trieben / Citron' und Mandelbaum;",
      "language": [],
      "musenalm_id": 129626,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der Schutzengel. / Calabresisches Volkslied nach Alphons de Lamartine",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "And. Schumacher",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der Schutzengel. / Calabresisches Volkslied nach Alphons de Lamartine",
