    {
      "annotation": "Anm. am Objekt: Hierzu die Abbildung als artistische Zugabe der Verlagshandlung /) s. Graphik INr 111106, Obj 6",
      "content_type": [],
      "created": "2026-06-11 10:18:41.717Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Er ging mit guten Waffen, der Sänger, in das Feld, / Da hat er seinen Gegner, den frechen hingestellt,",
      "language": [],
      "musenalm_id": 111107,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Im Schilde",
      "pseudonym": true,
      "publication_statement": "",
      "responsibility_statement": "Bernd von Guseck",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Im Schilde",
      "updated": "2010-03-15 00:00:00.000Z",
      "variant_title": "",
      "year": 1846,
