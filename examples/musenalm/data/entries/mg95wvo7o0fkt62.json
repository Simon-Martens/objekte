    {
      "annotation": "Dem Text vorangestellt: Motto: Lasset der Welt nur den Lauf, und das Wasser / dann findet ihn selbst schon. /) mit einer Illustration s. Graphik INr 110560, Obj 5",
      "content_type": [],
      "created": "2026-06-11 10:18:32.938Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Schönen guten Abend, Herr Pastor! Hier bringe ich die sechs Dreier Reisegeld nach Amerika von meinem Vater! So sprach eine junge Mädchenstimme in unser abenddunkles Zimmer herein,",
      "language": [],
      "musenalm_id": 102962,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die / Probefahrt nach Amerika. / Novelle",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Leopold Schefer",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die / Probefahrt nach Amerika. / Novelle",
      "updated": "2010-03-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1836,
      "editor": "",
      "agents": [
