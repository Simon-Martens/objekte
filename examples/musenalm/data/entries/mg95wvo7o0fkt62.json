    {
      "annotation": "mit einer Illustration s. Graphik INr 110563, Obj 8",
      "content_type": [],
      "created": "2026-06-11 10:18:32.938Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "207",
      "incipit_statement": "Der alte noble Lorrain, René Callot war einer der berühmtesten Sachwalter, welcher ums Jahr 1609 in der schönen Stadt Nancy lebten. Alle Einwohner kannten ihn, die Großen wie die Kleinen,",
      "language": [],
      "musenalm_id": 102964,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
