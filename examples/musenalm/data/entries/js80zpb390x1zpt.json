      "musenalm_id": 102569,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Der Illuminatismus im A B C Buche. / Eine neue Entdeckung, den Herrn v. Schirach in Altona, Reichard in Gotha, v. Grolmann / in Giesen, Girtanner in Göttingen, Hof- / Mann und Hofstätter in Wien vorzugsweise ver- / traulichst mitgetheilt und nebenbey in die Welt / geschrieen, zur Unterstützung der »Guten, / die zusammenhalten.«",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Der Illuminatismus im A B C Buche. / Eine neue Entdeckung, den Herrn v. Schirach in Altona, Reichard in Gotha, v. Grolmann / in Giesen, Girtanner in Göttingen, Hof- / Mann und Hofstätter in Wien vorzugsweise ver- / traulichst mitgetheilt und nebenbey in die Welt / geschrieen, zur Unterstützung der »Guten, / die zusammenhalten.«",
      "updated": "2012-11-19 00:00:00.000Z",
