      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Ein Glaubenskelch! wohlverstanden, derjenigen Art, woraus ein Suwarow trinkt, und alle Priester und Bonzen und Schwerdtapostel getrunken haben,",
      "language": [],
      "musenalm_id": 102563,
      "musenalm_pagination": [],
