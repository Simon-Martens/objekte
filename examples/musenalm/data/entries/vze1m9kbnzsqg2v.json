    {
      "annotation": "Erklärung der Kupfer (Sammlung INrt 63324, Obj 3) s. Titelportrait INr 63322, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:18:13.670Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Maria von Burgund war die Tochter Karls des Kühnen, und der Isabella von Bourbon, einer Tochter Karls, Herzogs von Bourbon,",
      "language": [],
      "musenalm_id": 63325,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
