      "variant_title": "",
      "year": 1816,
      "editor": "",
      "agents": [],
      "source_id": "p45vqajoyaawyja"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:50.822Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "71",
      "incipit_statement": "Was dir Natur geschenkt, was dir die Kunst verliehn, / Was dir die Götter all’ in deine Wiege legten, / Es ist ein Zauberreitz, ein ew’ges Jugendblühn, Es ist die Wunderkraft, womit zur Liebe Glühen / Sie in der stillen Brust das Menschenherz bewegten.",
      "language": [],
      "musenalm_id": 128808,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied",
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "An August Brede",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Nehrlich",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "An August Brede",
      "updated": "2010-01-20 00:00:00.000Z",
      "variant_title": "",
      "year": 1816,
      "editor": "",
      "agents": [
        {
          "annotation": "",
