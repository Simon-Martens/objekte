      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "45",
      "incipit_statement": "Vergessen soll ich ihn, den trauten Freund vergessen, / Vergebens! Ach! Wer hat der Liebe Macht ermessen? Der süßen Leidenschaft besiegende Gewalt?",
      "language": [],
      "musenalm_id": 128807,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "szen. Darstellung"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Erfüllte Pflicht bringt Lohn. / Spiel / in einem Akt, von C. H.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "C. H.",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Erfüllte Pflicht bringt Lohn. / Spiel / in einem Akt, von C. H.",
