    {
      "annotation": "Miniatur-Salon. Ausstellung 1844 (Sammlung INr 44130, Obj 5) Dem Text vorangestellt: Ich verachte jedes Machwerk und erkenne Nichts als Kunst an, was nicht lebt; [...] [P. v. Cornelius] s. Titelportrait INr 44126, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:18:02.541Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "Wir sehen hier den ersten und größesten Reformator der Kunst, den feurigsten und kräftigsten Apostel des in dem Vereine deutscher Künstler zu Rom erwachenden neuen Zeitalters,",
      "language": [],
      "musenalm_id": 44131,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Zu Peter von Cornelius' Portrait",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Zu Peter von Cornelius' Portrait",
      "updated": "2006-06-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1844,
      "editor": "",
      "agents": [],
      "source_id": "tzpn3xtul0trvq0"
    },
    {
      "annotation": "Miniatur-Salon. Ausstellung 1844 (Sammlung INr 44130, Obj 5) s. Graphik INr 44133, Obj 8",
      "content_type": [],
      "created": "2026-06-11 10:18:02.541Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "15",
      "incipit_statement": "Der erste Theil des Faust erschien, nachdem der Dichter seit 1774 in oft langen Pausen die einzelnen Scenen ausgearbeitet hatte,1807 zum ersten Male in der Form, die er in den gesammelten Werken behalten hat,",
      "language": [],
      "musenalm_id": 44132,
      "musenalm_pagination": [
