    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:36.592Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "43",
      "incipit_statement": "Die Römer hatten Pferde, die sie Funales oder Dextrarios nannten, welche man ihnen als Handpferde nachführte,",
