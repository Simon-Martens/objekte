    {
      "annotation": "Es folgen 5 Kapitel INr 106181-106185, Obj 8-12",
      "content_type": [],
      "created": "2026-06-11 10:18:38.943Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Es gibt vielleicht, außer Petersburg und London, nicht leicht eine Stadt in Europa, welche, wie Wien, nicht allein in Hinsicht ihrer Größe und Zahl ihrer Einwohner, sondern auch wegen der sich daselbst aufhaltenden Reichen und Großen, so vieles Aufsehen",
      "language": [],
      "musenalm_id": 106180,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Pferdeliebhaberey, Reitkunst, Equi- / pagen, Pferdehandel, und Thier- / Arzneykunst in Wien",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Pferdeliebhaberey, Reitkunst, Equi- / pagen, Pferdehandel, und Thier- / Arzneykunst in Wien",
      "updated": "2010-02-17 00:00:00.000Z",
      "variant_title": "",
      "year": 1810,
      "editor": "",
      "agents": [],
      "source_id": "4uvghaokccpl2kz"
    },
    {
      "annotation": "Pferdeliebhaberey, Reitkunst, Equipagen, Pferdehandel, und Thier-Arzneykunst in Wien",
      "content_type": [],
      "created": "2026-06-11 10:18:38.943Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "2",
      "incipit_statement": "Es gehört hier mit zu dem Modeton, schöne Pferde und schöne Equipagen zu haben.",
      "language": [],
      "musenalm_id": 106181,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
