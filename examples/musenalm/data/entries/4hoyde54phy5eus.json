    {
      "annotation": "Pferdeliebhaberey, Reitkunst, Equipagen, Pferdehandel, und Thier-Arzneykunst in Wien /) s. Titelgraphik INr 106175, Obj 2",
      "content_type": [],
      "created": "2026-06-11 10:18:38.100Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "4",
      "incipit_statement": "Die kasierliche Reitbahn (siehe das Titelkupfer) an der Burg, sonst auch die spanische Reitschule genannt, gehört ohnstreitig zu den schönsten Gebäuden und Merkwürdigkeiten Wiens.",
      "language": [],
      "musenalm_id": 106182,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Reitkunst",
      "pseudonym": false,
      "publication_statement": "",
