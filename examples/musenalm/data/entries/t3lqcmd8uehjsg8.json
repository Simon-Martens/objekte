    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:25.385Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "5",
      "incipit_statement": "Mit den Gefühlen der tiefsten Ehrfurcht wage ich es, den erlauchten Namen Euer Königlichen Hoheit einem Werke vorzusezen, das ich vor andern Unternehmungen in meiner Geschäftslaufbahn mit der größten Liebe und Sorgfalt umfaßte.",
      "language": [],
      "musenalm_id": 82072,
