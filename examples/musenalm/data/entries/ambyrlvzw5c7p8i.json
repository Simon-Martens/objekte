      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Über die Bildung der Künstler zur Men- / schendarstellung auf der Bühne. / (Fortsetzung.)",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
