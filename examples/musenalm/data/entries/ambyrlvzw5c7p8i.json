    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:38.051Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "14",
      "incipit_statement": "Dieser Mann pflegte, in seinem gerechten Eifer für die Sache, mit Ungestüm zu sagen: die Probe ist so ehrwürdig, als die Beichte, und die Vorstellung so heilig, als die Messe.",
      "language": [],
      "musenalm_id": 110748,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. / Über ein Sprüchwort des alten Schau- / spielers Uhlich, aus den Zeiten / von 1739",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. / Über ein Sprüchwort des alten Schau- / spielers Uhlich, aus den Zeiten / von 1739",
      "updated": "2010-01-07 00:00:00.000Z",
      "variant_title": "",
      "year": 1812,
      "editor": "",
      "agents": [],
      "source_id": "ytm0snt6wteqm6e"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:38.051Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "26",
      "incipit_statement": "Es war eine überaus gute Stunde, als Sie vergangenen Winter sich mit mir zum Kamine setzten, und mein Anliegen zu Herzen nahmen.",
      "language": [],
      "musenalm_id": 110749,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
