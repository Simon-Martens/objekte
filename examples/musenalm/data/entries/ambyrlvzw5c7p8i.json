    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:38.051Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Allerdings ist es das erste Erforderniß, daß die Worte des Dichters gehört werden.",
      "language": [],
      "musenalm_id": 110747,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
