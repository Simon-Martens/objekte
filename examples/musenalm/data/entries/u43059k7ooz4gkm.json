      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "1. Hirschhorn",
      "updated": "2006-04-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1816,
      "editor": "",
      "agents": [],
      "source_id": "m5kkxmijmq3rygq"
    },
    {
      "annotation": "II. Vier Landschaften nach Fohr, von Haldenwang (Sammlung INr 43409, Obj 6) Erklärung der Kupfer (Sammlung INr 43407, Obj 4) s. Graphik INr 43421, Obj 18",
      "content_type": [],
      "created": "2026-06-11 10:17:59.509Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Der hohe Thurm, welcher hier auf der rechten Seite der Ruine zuerst erscheint, ist ein Werk des Churfürst Ludwig V., der mit Recht den Beinamen des Friedfertigen trug.",
      "language": [],
      "musenalm_id": 43411,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "2. Das Heidelberger Schloß / von der Ostseite",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "2. Das Heidelberger Schloß / von der Ostseite",
