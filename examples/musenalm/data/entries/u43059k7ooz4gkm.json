      "variant_title": "",
      "year": 1816,
      "editor": "",
      "agents": [],
      "source_id": "2mavby5uyq5srx7"
    },
    {
      "annotation": "II. Vier Landschaften nach Fohr, von Haldenwang (Sammlung INr 43409, Obj 6) Erklärung der Kupfer (Sammlung INr 43407, Obj 4) s. Graphik INr 43422, Obj 19",
      "content_type": [],
      "created": "2026-06-11 10:17:59.510Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Wenn man bei der Stadt Wimpfen (am Berg) die nach der Neckarüberfahrt hinabziehende Straße vermeidet, und den links führenden Fußsteig verfolgt,",
      "language": [],
      "musenalm_id": 43412,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
