    {
      "annotation": "Beitrag mit zahlreichen Briefen und Gedichten der im Titel angegebenen Autoren",
      "content_type": [],
      "created": "2026-06-11 10:18:21.960Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "144",
      "incipit_statement": "In einer Zeit, die mehr als jede frühere voll Pietät für die Namen ausgezeichneter Menschen, ihnen Denkmale in Erz und Marmor, wie in den Prachttypen ihres verklungenen lebendigen Wortes zu setzen bemüht ist,",
      "language": [],
      "musenalm_id": 77797,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Sophie Becker / und ihr Verhältniß zu / Elisa v. d. Recke, der Herzogin von Kurland, Tiedge, Gleim, / Klamer-Schmidt, Bürger, Nicolai, Moses Mendelssohn / und mehreren andern ihrer Zeitgenossen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Julie von Großmann",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Sophie Becker / und ihr Verhältniß zu / Elisa v. d. Recke, der Herzogin von Kurland, Tiedge, Gleim, / Klamer-Schmidt, Bürger, Nicolai, Moses Mendelssohn / und mehreren andern ihrer Zeitgenossen",
      "updated": "2010-02-02 00:00:00.000Z",
      "variant_title": "",
      "year": 1843,
      "editor": "",
      "agents": [
        {
          "annotation": "",
          "conjecture": false,
          "created": "2026-06-11 10:19:00.836Z",
          "edit_comment": "",
          "type": "Autor:in",
