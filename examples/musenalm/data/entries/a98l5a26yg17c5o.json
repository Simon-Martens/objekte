      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Der Baum erhebt in fröhlicher Bewegung, / Die Blume schwelgt im grünen Schaum der Wiesen,",
      "language": [],
      "musenalm_id": 92724,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
