      "content_type": [],
      "created": "2026-06-11 10:17:59.004Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "36",
      "incipit_statement": "Als mein Sohn Gerichtsverweser worden war, wollt' ich ihm für seine ausgestandene Angst bei'm Examen recht was bene thun.",
      "language": [],
      "musenalm_id": 37577,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II.",
      "pseudonym": false,
