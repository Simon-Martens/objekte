    {
      "annotation": "Annotationen / aus / Mathias Ehrlichs Haushaltungs-Kalender (Sammlung INr 37575, Obj 8)",
      "content_type": [],
      "created": "2026-06-11 10:17:57.650Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "35",
      "incipit_statement": "Mein Vater seliger erzählte mir unter andern einen sonderlichen Kasus von Suum cuique. Er hatt' einen wichtigen Prozeß mit seinem Nachbarn Süß.",
      "language": [],
      "musenalm_id": 37576,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
