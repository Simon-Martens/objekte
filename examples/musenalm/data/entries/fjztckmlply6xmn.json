      "musenalm_id": 37579,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Ueber einige Arten von Köpfen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Ueber einige Arten von Köpfen",
      "updated": "2005-04-08 00:00:00.000Z",
      "variant_title": "",
      "year": 1801,
