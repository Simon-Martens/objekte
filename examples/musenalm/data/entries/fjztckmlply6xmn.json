    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:17:59.004Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "38",
      "incipit_statement": "Mit einem Worte, mein lieber Major! Deine Nicht ist keine Frau für meinen jungen Kapitain, und wenn sie schön, wie ein Engel, und reich, wie ein Kornjude wäre.",
