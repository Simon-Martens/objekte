      "created": "2026-06-11 10:18:13.988Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "92",
      "incipit_statement": "Schon in dem vorferndigen Jahrgang dieses Taschenbuchs S. 768. habe ich es meinen Lesern versprochen, zur gelegenen Zeit auch das Nöthige über die Bekanntmachung und Beobachtung der Schulgesezze zu sagen.",
      "language": [],
      "musenalm_id": 76642,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "IV. / Etwas über die Schulgesezze, / besonders deren Bekanntmachung und / Beobachtung",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "IV. / Etwas über die Schulgesezze, / besonders deren Bekanntmachung und / Beobachtung",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1792,
      "editor": "",
      "agents": [],
      "source_id": "jn2wo3wcldkggfx"
    },
    {
