    {
      "annotation": "Vorwort des Herausgebers",
      "content_type": [],
      "created": "2026-06-11 10:18:49.799Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Es ist der Plan dieses Taschenbuches, eine Sammlung original-deutscher Novellen zu liefern,",
      "language": [],
