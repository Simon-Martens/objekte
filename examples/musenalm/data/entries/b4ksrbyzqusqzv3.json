    {
      "annotation": "Motto",
      "content_type": [],
      "created": "2026-06-11 10:18:49.799Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Edel sey der Mensch, / hülfreich und gut! / Denn das allein / unterscheidet ihn / von / allen Wesen, die wir kennen.",
      "language": [],
      "musenalm_id": 127109,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Edel sey der Mensch, / hülfreich und gut! / Denn das allein / unterscheidet ihn / von / allen Wesen, die wir kennen.…",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Goethe",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "",
      "updated": "2021-02-20 00:00:00.000Z",
