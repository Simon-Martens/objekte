      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Es ist der Plan dieses Taschenbuches, eine Sammlung original-deutscher Novellen zu liefern,…",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "P. Glanzow",
      "scans": [],
