    {
      "annotation": "mit einer Illustration s. Graphik INr 95821, Obj 6",
      "content_type": [],
      "created": "2026-06-11 10:18:33.087Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "Dünn und unendlich zart sind die Gewebe des Seidenwurms, dünner aber, und noch unendlich zärter sind die Gewebe der Schicksale des Menschen.",
      "language": [],
      "musenalm_id": 95829,
      "musenalm_pagination": [
