      "created": "2026-06-11 10:18:23.183Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "55",
      "incipit_statement": "Ein Affe von bekanntem bösen Herzen schmäht' in König Löwens Gegenwart auf ein junges feuriges Roß, das ihn beleidigt hatte.",
      "language": [],
      "musenalm_id": 79396,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der Affe und das Pferd",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der Affe und das Pferd",
