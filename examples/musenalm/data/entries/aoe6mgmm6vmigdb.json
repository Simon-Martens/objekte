      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "5",
      "incipit_statement": "Schlum're, Liebchen, bist noch klein, / Weißt vom schönen Sonnenschein",
      "language": [],
      "musenalm_id": 79389,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
