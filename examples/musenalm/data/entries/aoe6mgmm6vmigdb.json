      "musenalm_id": 79397,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Rührendes Beyspiel eines edlen / Landmanns",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Rührendes Beyspiel eines edlen / Landmanns",
      "updated": "2011-12-19 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
