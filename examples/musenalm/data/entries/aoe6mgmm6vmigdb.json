    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:23.182Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "Ein Vater und eine Mutter hatten drey Kinder; zwey Söhne und eine Tochter. Beyde Eltern hielten gar viel von ihren Kindern, weil sie artig und folgsam waren.",
      "language": [],
      "musenalm_id": 79390,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der Vater mit seinen Kindern / unter dem Apfelbaume",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der Vater mit seinen Kindern / unter dem Apfelbaume",
      "updated": "2011-12-19 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "dvgyrw40ppsbzk1"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:23.182Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "11",
      "incipit_statement": "An einem schönen Morgen gieng die Mutter mit ihrem Kinde in den Garten. Als sie nahe an das Thor kamen, lief das Kind an die Hecken, und sahe den Ameisen zu.",
      "language": [],
      "musenalm_id": 79391,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Unterredung / der Mutter mit ihrem Kinde / über die Belohnungen des Fleißes. / Bey Gelegenheit eines kleinen Spazierganges",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Unterredung / der Mutter mit ihrem Kinde / über die Belohnungen des Fleißes. / Bey Gelegenheit eines kleinen Spazierganges",
      "updated": "2011-12-19 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "bdfi86sur4o0zoo"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:23.182Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "17",
      "incipit_statement": "Das Schaaf mußte von allen Thieren vieles leiden. Da trat es vor den Jupiter und bath, sein Elend zu mildern.",
      "language": [],
      "musenalm_id": 79392,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Jupiter und das Schaaf. / Eine Fabel",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Jupiter und das Schaaf. / Eine Fabel",
      "updated": "2011-12-19 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "a4nd4f1m9z19j5x"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:23.182Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "19",
      "incipit_statement": "Schön! da seyd ihr ja Kinder. Eben habe ich etwas gelesen, was euch recht angenehm seyn wird.",
      "language": [],
      "musenalm_id": 79393,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Reise nach England. / Ein Gespräch. / Der Lehrer. Henriette. Malchen. Jean. / Samchen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Reise nach England. / Ein Gespräch. / Der Lehrer. Henriette. Malchen. Jean. / Samchen",
      "updated": "2011-12-19 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "572tpeqnaeaeifn"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:23.183Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "53",
      "incipit_statement": "Ein Knabe spielte mit einer zahmen Schlange. Mein liebes Thierchen, sagte der Knabe, ich würde mich mit dir so gemein nicht machen, wenn dir das Gift nicht benommen wäre.",
      "language": [],
      "musenalm_id": 79394,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der Knabe und die Schlange",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der Knabe und die Schlange",
      "updated": "2011-12-19 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "je0bx0wc60llr7q"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:23.183Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "55",
      "incipit_statement": "Hast du wohl einen größern Wohlthäter unter den Thieren, als uns? fragte die Biene den Menschen.",
      "language": [],
      "musenalm_id": 79395,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
