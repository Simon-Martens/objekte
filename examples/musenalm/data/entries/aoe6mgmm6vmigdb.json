      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Reise / einer guten Mutter mit ihrem Kinde / auf ihr Landgut",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Reise / einer guten Mutter mit ihrem Kinde / auf ihr Landgut",
