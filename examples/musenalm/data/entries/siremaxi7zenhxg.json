    {
      "annotation": "$ unbezeichneter Prosabeitrag wahrscheinlich von Clauren, d. i. K. G. S. Heun",
      "content_type": [],
      "created": "2026-06-11 10:18:37.529Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "221",
      "incipit_statement": "Fügen Sie sich immer, sagte mein Pächter, und reisen Sie in Gottesnamen. Sie brauchen ja nicht gleich zu heirathen, aber besehen Sie sich das Mädchen.",
      "language": [],
      "musenalm_id": 103842,
