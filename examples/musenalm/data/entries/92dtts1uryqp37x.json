    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:30.036Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "13",
      "incipit_statement": "So glücklich Frankreich in Europa seine Plane verfolgte; in Westindien vermochte es weder Macht noch List, ihm seine Kolonien wiederzugeben.",
      "language": [],
      "musenalm_id": 92572,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Zweyter Abschnitt. / Frankreichs Verhältniß zu seinen Kolonien und den / von ihm beschützten Ländern, zur Schweiz, Hol- / land und Italien",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "J. Schwaldopler",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Zweyter Abschnitt. / Frankreichs Verhältniß zu seinen Kolonien und den / von ihm beschützten Ländern, zur Schweiz, Hol- / land und Italien",
