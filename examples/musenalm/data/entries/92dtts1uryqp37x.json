    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:30.036Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "5",
      "incipit_statement": "So war denn der Streit fürs erste ausgekämpft, in welchen die schreckliche Revolution Galliens beynahe das ganze übrige Europa verflocht.",
      "language": [],
      "musenalm_id": 92571,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Erster Abschnitt. / Innere Einrichtungen Frankreichs. Errichtung der / Senatorien. Wiederherstellung des Nazionalin- / stitutes. Belebung des Handels. Weitere An- / stalten zum Flore der Kirchen und Lyzäen. Annäherung des ersten Konsuls zur vollen Souveränität",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "J. Schwaldopler",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Erster Abschnitt. / Innere Einrichtungen Frankreichs. Errichtung der / Senatorien. Wiederherstellung des Nazionalin- / stitutes. Belebung des Handels. Weitere An- / stalten zum Flore der Kirchen und Lyzäen. Annäherung des ersten Konsuls zur vollen Souveränität",
      "updated": "2013-09-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1807,
      "editor": "",
      "agents": [
        {
          "annotation": "",
          "conjecture": false,
