    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:29.439Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "22",
      "incipit_statement": "Zu Amiens war der Friede zwischen Frankreich und England geschlossen, Whitwort nach Paris, Andreossy nach London gekommen, und doch schien das Band zwischen beiden Staaten immer lockerer zu werden.",
      "language": [],
      "musenalm_id": 92573,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Dritter Abschnitt. / Frankreichs Verhältniß zu den übrigen europäischen / Staaten, zu England, Spanien, Portugal, / Deutschland, Preussen, Oesterreich, den nor- / dischen Staaten, und der ottomanischen Pforte",
      "pseudonym": false,
