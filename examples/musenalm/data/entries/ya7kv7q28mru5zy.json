    {
      "annotation": "Beitrag zur Sammlung »Gedichte« (INr 130953, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.962Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "77",
      "incipit_statement": "Es stürzte selbst der Vorzeit Glanz in Trümmern, / Verwehet ist des Felsendenkmals Spur; / Wie strahlte noch vor kurzem Luna’s Schimmer, / Doch schon umschleiert Nacht die weite Flur.",
      "language": [],
      "musenalm_id": 130954,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Sonett",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Sonett",
      "updated": "2010-02-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "8b4spbv1lcap8ot"
    },
    {
      "annotation": "Beitrag zur Sammlung »Gedichte« (INr 130953, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.962Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "78",
      "incipit_statement": "Ha! wer schwebt dort in Juwelenflammen / Holde, von Verklärungsschein umringt! / Von dem Himmel muß die Heil’ge stammen, / Deren Libesblik zum Herzen dringt",
      "language": [],
      "musenalm_id": 130955,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Phantasie. / an / Madame Haßloch, / als Königin Elisabeth",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Julius",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Phantasie. / an / Madame Haßloch, / als Königin Elisabeth",
      "updated": "2010-02-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "7h383ocovynisq4"
    },
    {
      "annotation": "Beitrag zur Sammlung »Gedichte« (INr 130953, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.963Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "80",
      "incipit_statement": "So ruft mir meinen Harfner her! / Spach Herzog Leopold / Den muntern Sänger acht’ ich mehr, / Als all mein rotes Gold.",
      "language": [],
      "musenalm_id": 130956,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Ein Lied aus alter Zeit. / Herzog Leopold von Oesterreich / und der / Minnesänger",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Ein Lied aus alter Zeit. / Herzog Leopold von Oesterreich / und der / Minnesänger",
      "updated": "2010-02-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "zvjx7u5lxn0ai9a"
    },
    {
      "annotation": "Beitrag zur Sammlung »Gedichte« (INr 130953, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.963Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "83",
      "incipit_statement": "Du singst von der Vergänglichkeit, / und suchst nach ihrem Bild dich müd’ / O Lieber, suche nur nicht weit, / Vergleich sie keck mit deinem Bild!",
      "language": [],
      "musenalm_id": 130957,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Sinngedicht, / An N. N.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Sinngedicht, / An N. N.",
      "updated": "2010-02-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "uo3bjb7ivqd1895"
    },
    {
      "annotation": "Beitrag zur Sammlung »Gedichte« (INr 130953, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.963Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "84",
      "incipit_statement": "Ein Bauersmann von Jahren schon, / Gebückt und mit unsichrem Tritte, / Erschien vor seines Fürsten Throne / Mit einer Demuthsvollen Bitte.",
      "language": [],
      "musenalm_id": 130958,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der Fürst und der Bauer",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der Fürst und der Bauer",
      "updated": "2010-02-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "idsska1xdhqze04"
    },
    {
      "annotation": "Beitrag zur Sammlung »Gedichte« (INr 130953, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.963Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "87",
      "incipit_statement": "Also sehen wir uns wieder? / Solch ein Unglückstag erschien?! / Romas Freiheit stürzt darnieder, / Ach, auf ewig stürzt sie hin.",
      "language": [],
      "musenalm_id": 130959,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Cicero nnd [sic!] Cato / nach der pharsalischen Schlacht",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Cicero nnd [sic!] Cato / nach der pharsalischen Schlacht",
      "updated": "2010-02-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "mea389nrtf9eew1"
    },
    {
      "annotation": "Beitrag zur Sammlung »Gedichte« (INr 130953, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.963Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "88",
      "incipit_statement": "Glückselig ist der Mann, der gleich dem Ahnen- / volke / Mit eignem Stier die Vaterflur bebaut!",
      "language": [],
      "musenalm_id": 130960,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Lob des Landlebens / nach Horaz. Epop. II",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Horaz [bearb. ]unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Lob des Landlebens / nach Horaz. Epop. II",
      "updated": "2010-02-16 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "77u2tjigaa8hvdj"
    },
    {
      "annotation": "Beitrag zur Sammlung »Gedichte« (INr 130953, Obj 9)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.963Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "92",
      "incipit_statement": "Von blaunigtem Gestade / Schau ich den stillen See: / Jetzt ist mir’s wohl im Herzen; / Doch ach! jetzt wieder weh.",
      "language": [],
      "musenalm_id": 130961,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Lied / am Genfersee. / Gesungen von einem deutschen Krieger / im April 1814",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Lied / am Genfersee. / Gesungen von einem deutschen Krieger / im April 1814",
      "updated": "2010-02-16 00:00:00.000Z",
