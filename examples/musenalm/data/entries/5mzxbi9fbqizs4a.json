      "agents": [],
      "source_id": "x5lprse51pwlq9y"
    },
    {
      "annotation": "VI. Miszellen (Sammlung INr 82864, Obj 12)",
      "content_type": [],
      "created": "2026-06-11 10:18:26.958Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "125",
      "incipit_statement": "Von fruchtbaren Aeckern udnd Wiesenland umgeben, liegt auf dem erhöhten nördlichen Gebirgsfuße des untern Hauensteins das Dorf Läufelsingen,",
      "language": [],
      "musenalm_id": 82869,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
