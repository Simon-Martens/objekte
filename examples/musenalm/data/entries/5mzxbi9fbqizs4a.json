      "editor": "",
      "agents": [],
      "source_id": "fuck1gblklln5tg"
    },
    {
      "annotation": "VI. Miszellen (Sammlung INr 82864, Obj 12)",
      "content_type": [],
      "created": "2026-06-11 10:18:26.957Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "117",
      "incipit_statement": "Bald nach der Schlacht bei St. Jakob im Jahr 1444, in welcher durch die tapferen Eidgenossen der Armagnaken so viele erschlagen wurden, daß der oberste Anführer, der Dauphin von Frankreich, gesagt haben soll:",
      "language": [],
      "musenalm_id": 82866,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "2. Von alter Sundgauer Ehrlichkeit / ein Pröbchen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "2. Von alter Sundgauer Ehrlichkeit / ein Pröbchen",
      "updated": "2011-12-01 00:00:00.000Z",
      "variant_title": "",
      "year": 1830,
      "editor": "",
      "agents": [],
      "source_id": "9a65umb23h53e4t"
    },
    {
      "annotation": "VI. Miszellen (Sammlung INr 82864, Obj 12)",
      "content_type": [],
      "created": "2026-06-11 10:18:26.957Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "119",
      "incipit_statement": "Mit vollem Recht heißen wir das fünfzehnte Jahrhundert in unserer Baslergeschichte das kriegerische, oder noch besser gesagt, das heroische; denn während desselben kämpften die alten Basler gegen ihr zahllosen Feinde.",
      "language": [],
      "musenalm_id": 82867,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "3. / Ein Ehekontrakt aus dem fünf- / zehnten Jahrhundert",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "3. / Ein Ehekontrakt aus dem fünf- / zehnten Jahrhundert",
      "updated": "2011-12-01 00:00:00.000Z",
      "variant_title": "",
      "year": 1830,
      "editor": "",
      "agents": [],
      "source_id": "w93xmqnisaae74g"
    },
    {
      "annotation": "VI. Miszellen (Sammlung INr 82864, Obj 12)",
      "content_type": [],
      "created": "2026-06-11 10:18:26.958Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "122",
      "incipit_statement": "Bei der Wiederherstellung der Universität zu Basel im Jahr 1532 hegte der Magistrat die Absicht, daß sie wieder das werden solle,was sie ihrer ersten Anlage und Stiftung nach vor der Reformation gewesen war,",
      "language": [],
      "musenalm_id": 82868,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "4. Thomas Platers Meinung von der / Basler Hochschule",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "4. Thomas Platers Meinung von der / Basler Hochschule",
      "updated": "2011-12-01 00:00:00.000Z",
      "variant_title": "",
      "year": 1830,
