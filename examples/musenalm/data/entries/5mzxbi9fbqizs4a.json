    {
      "annotation": "VI. Miszellen (Sammlung INr 82864, Obj 12)",
      "content_type": [],
      "created": "2026-06-11 10:18:26.957Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "111",
      "incipit_statement": "Während des siebzehnten und noch zu Anfang des achtzehnten Jahrunderts wählten sich die evangelischen Gemeinden des Toggenburgs ihre Prediger und Seelsorger von Basel.",
      "language": [],
      "musenalm_id": 82865,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "1. Beiträge zur Gallerie der Opfer / evangelischer Pflichttreue",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "1. Beiträge zur Gallerie der Opfer / evangelischer Pflichttreue",
      "updated": "2011-12-01 00:00:00.000Z",
