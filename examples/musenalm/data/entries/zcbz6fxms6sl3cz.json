    {
      "annotation": "Beigabe zu »Ueber den Umschlag a priori« INr 64794, Obj 6",
      "content_type": [],
      "created": "2026-06-11 10:18:11.514Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "26",
      "incipit_statement": "Also gesund - die Muse sonder Titel / Verhoffet doch ein Jahr und mehr zu leben",
      "language": [],
      "musenalm_id": 64795,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Also gesund - die Muse sonder Titel / Verhoffet doch ein Jahr und mehr zu leben…",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "",
      "updated": "2009-06-24 00:00:00.000Z",
      "variant_title": "",
      "year": 1822,
      "editor": "",
