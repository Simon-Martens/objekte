    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:11.515Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "27",
      "incipit_statement": "Der Mensch ist eine Null, wenn er in's Leben / tritt, / Wie hell der Stern des Glücks ob seiner Wiege / funkle;",
      "language": [],
      "musenalm_id": 64796,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Poetisches Indosso",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Poetisches Indosso",
