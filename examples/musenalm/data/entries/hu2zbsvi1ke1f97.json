      "source_id": "mdvkmoe14amnl8y"
    },
    {
      "annotation": "Dem Text vorangestellt: Motto: L'indulgente et sage natur / A formé l'ame de Ninon [...] St. Evremont /) mit 2 Illustrationen s. Graphiken INr 100957, Obj 2 und INr 109960, Obj 5",
      "content_type": [],
      "created": "2026-06-11 10:18:35.603Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "115",
      "incipit_statement": "Heinrich der vierte, jener ritterliche Fürst, dessen Schwächen durch die Vorzüge seines Geistes und seines Herzens überragt wurden, hatte durch seine Nichtachtung sittlich-socialer Verhältnisse den Grund zu jener tiefen Verderbniß gelegt,",
      "language": [],
      "musenalm_id": 109967,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
