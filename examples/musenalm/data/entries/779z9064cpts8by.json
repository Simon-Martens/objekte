      "created": "2026-06-11 10:18:32.433Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "2",
      "incipit_statement": "In der unglücklichen Christ-Nacht 1813 begannen aus Hamburg besonders in der Richtung nach Altona die Menschen Austreibungen und dauerte den Winter fort,",
      "language": [],
      "musenalm_id": 96617,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Kurzer Abriß der Unglücklichen / in der Petri Kirche und Ver- / treibung der Menschen aus Hamburg in der Christ-Nacht / 1813 und darauf folgenden / Winter",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Kurzer Abriß der Unglücklichen / in der Petri Kirche und Ver- / treibung der Menschen aus Hamburg in der Christ-Nacht / 1813 und darauf folgenden / Winter",
      "updated": "2014-05-16 00:00:00.000Z",
