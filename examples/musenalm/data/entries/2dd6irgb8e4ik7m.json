      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1010",
      "incipit_statement": "Zu Frankenthal, der dritten Hauptstadt in dem Kurfürstenthum Pfalz, erhielten im vorigen Jahr die dortigen vier Schulmeister, von der evangelischlutherischen, der reformirten und der katholischen Kirche auf ihre Bitte, von dem Stadtrath jeder ein Stük",
      "language": [],
      "musenalm_id": 76631,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Verbesserung einiger Schuldienste",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Verbesserung einiger Schuldienste",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1791,
      "editor": "",
      "agents": [],
      "source_id": "dxb94p8ujdwnxe3"
    },
    {
