      "created": "2026-06-11 10:18:20.153Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1010",
      "incipit_statement": "Johann Kaspar Volkland, bürgerlicher Einwohner zu Süssenborn im Fürstenthum Weimar, hat 1789 die dasige Schulstelle mit einem Vermächtnisse von 400 Reichsthalern erhöhet,",
      "language": [],
      "musenalm_id": 76632,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
