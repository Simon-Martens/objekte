      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. / Von Industrie- oder Arbeits- auch / ökonomischen Schulen",
