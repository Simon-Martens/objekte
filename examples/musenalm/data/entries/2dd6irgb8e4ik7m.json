      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "986",
      "incipit_statement": "Nach meiner Ueberzeugnung sind die Schulvakanzen oder Schulferien mehr um der Lehrer als um der Schüler willen eingeführt.",
      "language": [],
      "musenalm_id": 76626,
      "musenalm_pagination": [
