      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Tarocl'hombre",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Tarocl'hombre",
