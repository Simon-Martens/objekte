    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:19.846Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "108",
      "incipit_statement": "Dieses Spiel hat eben dieselben Regeln, wie das l'Hombre en trois, es ist aber fast noch sinnreicher und künstlicher zu spielen, als jenes.",
      "language": [],
      "musenalm_id": 78573,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Vom l'Hombre en quatre, oder Kauf- / quadrille",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Vom l'Hombre en quatre, oder Kauf- / quadrille",
      "updated": "2010-02-11 00:00:00.000Z",
      "variant_title": "",
      "year": 1798,
      "editor": "",
      "agents": [],
      "source_id": "up01aev4tpp9mul"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:19.846Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "125",
      "incipit_statement": "Man muß bei diesem Spiele zum Grundsatz annehmen, daß es nach eben denselben Regeln, als Quadrille gespielt wird,",
      "language": [],
      "musenalm_id": 78574,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Vom Cinquille oder l'Hombre en cinq",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Vom Cinquille oder l'Hombre en cinq",
      "updated": "2010-02-11 00:00:00.000Z",
      "variant_title": "",
      "year": 1798,
      "editor": "",
      "agents": [],
      "source_id": "twh0cwo9881g7ow"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:19.846Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "134",
      "incipit_statement": "Man spielte ehedem das Tarocspiel auf eine vieleinfachere Art als jetzt. So war sonst z. B. nie von 7 Königen Matadors von unten und scüsirten Cavallerien die Rede.",
      "language": [],
      "musenalm_id": 78575,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
