    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:19.847Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "176",
      "incipit_statement": "Dieses Spiel kann nach Anzahl der 60 Karten, die es hat, unter 7 Personen gespielet werden, so daß, wenn ein jeder sieben Blätter nimmt, dennoch eilfe übrig bleiben.",
      "language": [],
      "musenalm_id": 78580,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Hommespiel",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Hommespiel",
      "updated": "2010-02-11 00:00:00.000Z",
      "variant_title": "",
      "year": 1798,
      "editor": "",
      "agents": [],
      "source_id": "hkkbnhjm5ues5uw"
    },
    {
