      "content_type": [],
      "created": "2026-06-11 10:18:19.847Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "172",
      "incipit_statement": "Dieses Spiel wird unter zwei Personen gespielt, und zwar so, daß wechselsweise nur eine immer die spielende Person ist.",
      "language": [],
      "musenalm_id": 78578,
      "musenalm_pagination": [
