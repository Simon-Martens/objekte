      "variant_title": "",
      "year": 1798,
      "editor": "",
      "agents": [],
      "source_id": "u6j0yepv8wxi8bt"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:19.847Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "165",
      "incipit_statement": "Dieses Spiel ist in Spanien erfunden worden, und hat seinen Namen davon, daß man darinnen von allem, was bei andern Spielen zu beobachten ist, das Gegentheil thut.",
      "language": [],
      "musenalm_id": 78577,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Reversyspiel",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Reversyspiel",
      "updated": "2010-02-11 00:00:00.000Z",
      "variant_title": "",
      "year": 1798,
      "editor": "",
      "agents": [],
      "source_id": "7k3ynvcquiaiwum"
