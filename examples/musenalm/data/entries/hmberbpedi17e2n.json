      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Tarocspiel",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Tarocspiel",
      "updated": "2010-02-11 00:00:00.000Z",
      "variant_title": "",
      "year": 1798,
      "editor": "",
      "agents": [],
      "source_id": "ykfc0ef27bzm9vq"
