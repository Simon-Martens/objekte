    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:19.847Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "174",
      "incipit_statement": "Dieses Spiel hat vollkommene Aehnlichkeit mit dem Patience, nur mit dem Unterschied, daß man von den 2 Spielkarten, davon jedes 52 Blätter hat, von oben 12 Karten verdeckt abzählet,",
      "language": [],
      "musenalm_id": 78579,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Cabalespiel",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Cabalespiel",
