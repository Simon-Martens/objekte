    },
    {
      "annotation": "enthält die Ankündigung eines Preisausschreibens für das beste eingesandte »Original-Lustspiel«. Dies soll der »Beförderung, auch des kleinen, deutschen Talents« dienen, gegen die »Uebermacht der Scribler, die nur von Ausländerei sich nähren«.",
      "content_type": [],
      "created": "2026-06-11 10:18:51.188Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Der siebente Jahrgang unsers »Jahrbuchs deutscher Bühnenspiele« tritt umso muthiger auf, als ihm seine sechs Vorgänger nach vielen Seiten hin Bahnen geöffnet haben.",
      "language": [],
      "musenalm_id": 128266,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Vorrede",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Vorrede",
      "updated": "2016-02-18 00:00:00.000Z",
      "variant_title": "",
      "year": 1828,
      "editor": "",
      "agents": [],
      "source_id": "u2mklhn3mp8qwyt"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:51.188Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Warum mein Herr Gemahl doch stets zu dieser Zeit / Sich aus dem Schloß begiebt in solcher Heimlichkeit?",
      "language": [],
      "musenalm_id": 128267,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "szen. Darstellung"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die schelmische Gräfin. / Lustspiel / in einem Aufzuge / von / Karl Immermann",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Karl Immermann",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die schelmische Gräfin. / Lustspiel / in einem Aufzuge / von / Karl Immermann",
      "updated": "2016-02-18 00:00:00.000Z",
      "variant_title": "",
      "year": 1828,
      "editor": "",
      "agents": [
        {
          "annotation": "",
