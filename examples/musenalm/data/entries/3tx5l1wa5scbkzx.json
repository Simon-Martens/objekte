      "created": "2026-06-11 10:18:25.337Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Der Normännischen Pferde-Rassen sind mehrere. Das eingebohrne Pferd ist im nordöstlichen Theile vom schweren Fuhrmannschlage,",
      "language": [],
      "musenalm_id": 85272,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Ueber / die Normannischen Pferde",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Ueber / die Normannischen Pferde",
      "updated": "2010-02-15 00:00:00.000Z",
      "variant_title": "",
      "year": 1822,
      "editor": "",
      "agents": [],
      "source_id": "wz2wrgs7la4toix"
    },
    {
