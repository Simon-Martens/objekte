      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "30",
      "incipit_statement": "Die in den Departements eingeführten Wettrennen bleiben ferner in zwei Klassen geschieden,",
      "language": [],
      "musenalm_id": 85274,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
