      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "18",
      "incipit_statement": "Die Hofgetüte stehen unter der Oberleitung des Oberstallmeisters. Es sind drei.",
      "language": [],
      "musenalm_id": 85273,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. / Kurze Uebersicht / der / österreichischen Hof- und Militär-Gestüte",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. / Kurze Uebersicht / der / österreichischen Hof- und Militär-Gestüte",
      "updated": "2010-02-15 00:00:00.000Z",
      "variant_title": "",
