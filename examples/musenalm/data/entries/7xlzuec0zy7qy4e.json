    {
      "annotation": "mit einer erläuternden Illustration (INr 125982, Obj 18)",
      "content_type": [],
      "created": "2026-06-11 10:18:49.278Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "113",
