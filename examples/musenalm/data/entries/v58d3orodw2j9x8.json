      "musenalm_id": 111602,
      "musenalm_pagination": [
        "2. Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Politische / Betrachtungen / über / die gegenwärtigen Zeitläufte, / von / J. P. Rabaut, / als / ein Anhang zu seinem Entwurfe / der / Geschichte / der / französischen Revolution. / Straßburg 1792. / bey Johann Georg Treuttel",
      "pseudonym": false,
      "publication_statement": "",
