    {
      "annotation": "mit zahlreichen Einträgen",
      "content_type": [],
      "created": "2026-06-11 10:18:42.073Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Ein Bürger der Sektion der Lombards zu Paris, der Wittwer und zugleich schon ziemlich alt war, hatte 4 Söhne, die einzigen Stüzen seines Alters",
