    {
      "annotation": "Erster Abschnitt. Regeln für Reisende (Sammlung INr 97408, Obj 5) mit zahlreichen Einträgen /) § SS 5-12 fehlen",
      "content_type": [],
      "created": "2026-06-11 10:18:31.031Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Man mache sich einen Plan von seiner ganzen Reise, die man unternehmen will; in diesem Plan muß alles aufgenommen seyn, was sich sowohl auf die Länge des Aufenthalts in jedem Orte, als auch auf die zu besehenden Merkwürdigkeiten bezieht.",
      "language": [],
      "musenalm_id": 97409,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Allgemeine Regeln für Reisende",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Joh. Chr. Fick",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Allgemeine Regeln für Reisende",
      "updated": "2012-02-23 00:00:00.000Z",
      "variant_title": "",
