      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "31",
      "incipit_statement": "Nach der Beschaffenheit des Clima in Deutschland wird man schon ohne mein Erinnern einsehen können, daß das Reisen auf deutschen Flüssen nur vom Frühling biß in Herbst zu empfehlen sey.",
      "language": [],
      "musenalm_id": 97412,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "IV. / Regeln für Reisende auf Flüssen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Joh. Chr. Fick",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "IV. / Regeln für Reisende auf Flüssen",
