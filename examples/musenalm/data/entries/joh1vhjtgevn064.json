      "created": "2026-06-11 10:18:32.240Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "16",
      "incipit_statement": "Wer das Geld dazu hat, um einen eignen Reisewagen zu haben, der sehe darauf, daß dieser gut und bequem sey.",
      "language": [],
      "musenalm_id": 97410,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. / Regeln für fahrende Reisende",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Joh. Chr. Fick",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. / Regeln für fahrende Reisende",
      "updated": "2012-02-23 00:00:00.000Z",
      "variant_title": "",
      "year": 1797,
      "editor": "",
      "agents": [],
      "source_id": "chjm8ticl2d63x3"
