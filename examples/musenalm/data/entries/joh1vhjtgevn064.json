      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "24",
      "incipit_statement": "Man sehe mehr auf die Stärke und Dauerhaftigekit seines Reitpferdes, als auf die Schönheit desselben.",
      "language": [],
      "musenalm_id": 97411,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
