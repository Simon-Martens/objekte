      "content_type": [],
      "created": "2026-06-11 10:18:53.781Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "206",
      "incipit_statement": "Ich weiß sehr wohl, daß alle unsere Mortalitätslisten nur eine unsichere Bais der Berechnungen der Witwenkassen abgeben können,",
      "language": [],
      "musenalm_id": 134075,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
