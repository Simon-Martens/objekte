    {
      "annotation": "II. Zwei Reden, von welchen die erstere bei der Wahl eines Schulmeisters, und die zweite bei der Vorstellung desselben von dem Pfarrer des Orts, gehalten worden (Sammlung INr 101909, Obj 3)",
      "content_type": [],
      "created": "2026-06-11 10:18:33.149Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "379",
      "incipit_statement": "Geehrteste Herren ! Die Absicht unsrer gegenwärtigen Zusammenkunft ist allzu bekannt, als daß ich Ursache hätte, hievon vieles zu sagen.",
      "language": [],
      "musenalm_id": 101910,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Erste Rede, / welche von der Schulmeisterswahl an den / wählenden Magistrat und die übrige Ge- / meindsdeputirte gehalten / worden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Erste Rede, / welche von der Schulmeisterswahl an den / wählenden Magistrat und die übrige Ge- / meindsdeputirte gehalten / worden",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "9enbd79simp9h31"
    },
    {
      "annotation": "II. Zwei Reden, von welchen die erstere bei der Wahl eines Schulmeisters, und die zweite bei der Vorstellung desselben von dem Pfarrer des Orts, gehalten worden (Sammlung INr 101909, Obj 3)",
      "content_type": [],
      "created": "2026-06-11 10:18:33.149Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "389",
      "incipit_statement": "Die Gnade unsers Herrn Jesu Christi, der seine Liebe auch gegen die Kinder ehemals so deutlich an den Tag legte, da er sie zu sich kommen hieß,",
      "language": [],
      "musenalm_id": 101911,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Zweite Rede, / welche bei der Vorstellung des neuen Schul- / meisters, nach vorhergegangenem öffent- / lichen Schulexamen gehalten worden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Zweite Rede, / welche bei der Vorstellung des neuen Schul- / meisters, nach vorhergegangenem öffent- / lichen Schulexamen gehalten worden",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "rmxzes95jp0koej"
    },
    {
      "annotation": "",
