      "created": "2026-06-11 10:18:33.150Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "405",
      "incipit_statement": "Da es bei dem gegenwärtigen Aufsaz meine Absicht ist, blos dasjenige zu berühren, was dem Schulmeister entweder beim Vorsingen in dem öffentlichen Gottesdienst, oder bei dem Singunterricht seiner Schüler brauchbar und nüzlich sein kann;",
      "language": [],
      "musenalm_id": 101912,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
