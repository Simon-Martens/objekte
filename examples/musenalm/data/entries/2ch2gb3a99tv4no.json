      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Von dem Verhalten kranker Pferde, als / Fortsetzung der im ersten Bändchen dieser / Schrift abgebrochenen Abhandlung, von dem / Verhalten gesunder Pferde.",
