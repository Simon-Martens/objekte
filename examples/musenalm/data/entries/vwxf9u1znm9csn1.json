    {
      "annotation": "mit einer Illustration s. Graphik INr 112658, Obj 10",
      "content_type": [],
      "created": "2026-06-11 10:18:43.657Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "227",
      "incipit_statement": "Vor mehreren Jahren lebte in Berlin ein gewisser Banquier Reichhell, der in der ganzen Stadt als ein sehr reicher Mann bekannt war,",
      "language": [],
      "musenalm_id": 112662,
