    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:43.657Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "351",
      "incipit_statement": "Der Schnee war geschmolzen und die Erde lag grün. Das Korn im Felde stand eben hoch genug, daß ein Hase darin sich verbergen, oder ein Huhn darin sein Nest bauen konnte.",
      "language": [],
      "musenalm_id": 112663,
