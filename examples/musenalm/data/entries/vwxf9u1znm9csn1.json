    {
      "annotation": "Dem Text vorangestellt: Aus den Wolken muß es fallen / Aus der Götter Schooß, das Glück,",
      "content_type": [],
      "created": "2026-06-11 10:18:43.552Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Im Vorzimmer des Bürgermeisters von Haarlem sah es ganz besonders bunt aus;",
      "language": [],
      "musenalm_id": 112660,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Götzenauge. / Novelle",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Ludmilla Rose",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Götzenauge. / Novelle",
      "updated": "2010-02-05 00:00:00.000Z",
      "variant_title": "",
      "year": 1836,
      "editor": "",
      "agents": [],
      "source_id": "d7i799obdxfvv5c"
    },
    {
