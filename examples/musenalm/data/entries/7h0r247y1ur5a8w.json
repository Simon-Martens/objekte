    {
      "annotation": "§ bez. Titelgraphik fehlt",
      "content_type": [],
      "created": "2026-06-11 10:18:53.633Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Habt ihr das erste Veilchen? Wirklich? - / Ein Veilchen habt ihr sicherlich:",
      "language": [],
      "musenalm_id": 135239,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
