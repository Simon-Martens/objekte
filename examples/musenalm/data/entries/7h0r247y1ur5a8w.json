    {
      "annotation": "Dem Beitrag vorangestellt: Leben gleicht der Töne Beben, / Und der Mensch dem Saitenspiel. / Müllner's Schuld",
      "content_type": [],
      "created": "2026-06-11 10:18:54.159Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "21",
      "incipit_statement": "Euer Beruf, Ihr Ärzte, ist doch herrlich, sprach ich zu meinem Freunde Viktor,",
      "language": [],
      "musenalm_id": 135262,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
