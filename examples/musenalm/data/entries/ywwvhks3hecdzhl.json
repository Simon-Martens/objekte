      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "11",
      "incipit_statement": "Man sagte mir, daß in einigen Tagen das große Schiff Phönix, welches Graf Festetics durch Zimmerleute, die er, wie er glaube, aus Ancona kommen ließ, erbaute, die gewöhnliche Fahrt nach Könöse machen würde.",
      "language": [],
      "musenalm_id": 92059,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Fahrt auf dem Plattensee in Ungern, und die / Umgebungen dieses Sees. / Meinem Freunde Johann v. Asboth, gräflich Georg / Festetitschischen Gütern in Késthély geweiht",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Wirthschaftsrath Eißl in Kärnthen",
      "scans": [],
