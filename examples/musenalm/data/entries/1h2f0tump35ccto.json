      "extent": "",
      "incipit_statement": "Gustav Adolph kam sehr jung zum Thron. In einer Nacht, da er auf einem Balle, den sein erster Minister gab, maskirt tanzte, entfiel der schönsten seiner Unterthaninnen die Maske,",
      "language": [],
      "musenalm_id": 132378,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Adlaide und Valvaise, / eine schwedische Geschichte",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [
        "alm_2869_132378_m0aw708jl4.jpg"
      ],
      "subtitle_statement": "",
      "title_statement": "Adlaide und Valvaise, / eine schwedische Geschichte",
      "updated": "2010-02-19 00:00:00.000Z",
      "variant_title": "",
      "year": 1781,
      "editor": "",
      "agents": [],
      "source_id": "gw7txdwn3y54yh3"
    },
    {
      "annotation": "mit einer Kopfvignette",
      "content_type": [],
      "created": "2026-06-11 10:18:53.185Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "41",
      "incipit_statement": "Damit ich Deinen Forderungen endlich genug thue, so will ich Dich eben von der künftigen Einrichtung unsers Lebens unterhalten. Ich werde mich nicht so sehr auf die allgemeinen Pflichten des Ehestandes einlassen.",
      "language": [],
      "musenalm_id": 132379,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Felix Hessens / Briefe  an seine Geliebte. / (Fortsetzung.)",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [
        "alm_2869_132379_4gyxi812gm.jpg"
      ],
      "subtitle_statement": "",
      "title_statement": "Felix Hessens / Briefe  an seine Geliebte. / (Fortsetzung.)",
