    {
      "annotation": "Anm. am Objekt: Der Held der Geschichte erzählt selbst",
      "content_type": [],
      "created": "2026-06-11 10:18:22.757Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Die finstern Alpenthäler Piemont's sind meine Heimath. Wohl muß ich ihn finster nennen, den Geist, der dort umgeht,",
      "language": [],
      "musenalm_id": 77829,
