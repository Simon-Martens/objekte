    {
      "annotation": "Dem Text vorangestellt: Motto. / Unter den Thaten kann kaum eine edlere gedacht werden, als die Befeiung der Menschheit von einer sie entehrenden Schmach, [...] / Herder",
      "content_type": [],
      "created": "2026-06-11 10:18:14.165Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Wenn eine nach Außen hochgestellte Frau bereits seit beinahe drei Jahrzehnten mit aller ihr innewohnenden Energie und Ausdauer unternimmt, die sittliche Aufbesserung der Sträflinge in den Gefängnissen ihrer Vaterstadt",
      "language": [],
      "musenalm_id": 63910,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Pantheon. / Elisabeth Fry. / Ein Lebensbild",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Dr. J. Günther",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Pantheon. / Elisabeth Fry. / Ein Lebensbild",
      "updated": "2009-05-04 00:00:00.000Z",
      "variant_title": "",
      "year": 1843,
      "editor": "",
      "agents": [],
      "source_id": "hra1s1vq7v72jpo"
    },
    {
      "annotation": "mit einer Illustration s. Graphik INr 63904, Obj 8",
      "content_type": [],
      "created": "2026-06-11 10:18:14.166Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "An dem Altartisch der Marienkirche zu Lübeck stand ein schlanker Jüngling, emsig beschäftigt mit den vor ihm liegenden Zeichengeräthen auf einem Bogen hellgrauen Papier,",
      "language": [],
      "musenalm_id": 63911,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Bruderfahrt. / Reise-Novelle",
      "pseudonym": false,
      "publication_statement": "",
