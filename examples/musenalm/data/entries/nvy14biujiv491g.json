      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "38",
      "incipit_statement": "Ueber die Gräber des Friedhofs von Mailand, über die Gräber, wo Menschen und ihre Hoffnungen, Wünsche und Träume, ihre Freuden und Schmerzen, Leidenschaften und Begierden, Haß und Liebe, Zagen und Vertrauen als Leichen begraben liegen,",
      "language": [],
      "musenalm_id": 65331,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
