    {
      "annotation": "Dem Text vorangestellt: Am Abgrund leitet der schwindliche Steg, / Er führt zwischen Leben und Sterben; [...] Schiller",
      "content_type": [],
      "created": "2026-06-11 10:18:10.402Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Hat man sich um den Fuß der serpentinsteinreichen Ingelsbergwand gewendet, so steht man dann wohl, und staunt, und schwelgt in dem Anblicke des sich hier öffnenden schönen und herrlichen Gebirgsthals.",
      "language": [],
      "musenalm_id": 65330,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Schlacht auf der Erzwiese",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Friedrich Wilhelm Arming",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Schlacht auf der Erzwiese",
      "updated": "2009-07-23 00:00:00.000Z",
