      "created": "2026-06-11 10:18:00.524Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Wenn Hofnung nach höherem Genuß die Seele hebt, dann muß den Reisenden der Hinblick auf Peru mit neuen Kräften beleben.",
      "language": [],
      "musenalm_id": 41500,
      "musenalm_pagination": [
