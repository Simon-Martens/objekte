      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "132",
      "incipit_statement": "Traurig war anfänglich das Loos der durch einige bewaffnete spanische Abentheuer eroberten neuen Welt.",
      "language": [],
      "musenalm_id": 41502,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
