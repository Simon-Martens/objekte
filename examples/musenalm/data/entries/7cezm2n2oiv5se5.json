      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "228",
      "incipit_statement": "Auch hier, wie in den schönsten Theilen der nördlichen neuen Welt, zeigt sich das traurigste Schauspiel für die Menschheit.",
      "language": [],
      "musenalm_id": 41504,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
