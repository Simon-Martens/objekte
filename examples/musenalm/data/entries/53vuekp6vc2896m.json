      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Sobald der Mensch durch gelegentliche Untersuchung die Annehmlichkeit, seine Nahrung und Kleidungsbedürfnisse außer dem ihm hierzu sich darbietenden Pflanzenreiche , auch aus Thierreiche auf abwechselndere Weise befriedigen zu können,",
      "language": [],
      "musenalm_id": 120518,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Skizze einer Urgeschichte des / Jagdwesens",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Herr Bürgermeister Winkler zu Osterburg in der Altmark",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Skizze einer Urgeschichte des / Jagdwesens",
      "updated": "2009-09-03 00:00:00.000Z",
