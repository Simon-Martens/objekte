      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Probe / aus dem nächstens bei Brönner in Frankfurt / am Main erscheinenden Werke: / Lehrbuch / der / Gestütswissenschaft [...]",
