    {
      "annotation": "Es folgt: Sammlung von 6 Beiträgen INr 132022-132027, Obj 13-18 als Textbezüge zu den Graphiken",
      "content_type": [],
      "created": "2026-06-11 10:18:51.629Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "10",
      "incipit_statement": "Unstreitig kennen alle Leserinnen dieses Jahrbuchs den beliebten Roman »Elisa oder das Weib wie es seyn sollte« wenigstens verdient er in den Händen eines jeden Mädchens zu seyn.",
      "language": [],
      "musenalm_id": 132021,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Graphik-Verzeichnis"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Erklärung der Kupfer",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Erklärung der Kupfer",
      "updated": "2010-01-22 00:00:00.000Z",
      "variant_title": "",
      "year": 1799,
      "editor": "",
      "agents": [],
      "source_id": "jjx9gdmimzcz72z"
    },
    {
      "annotation": "Erklärung der Kupfer (Sammlung INr 132021, Obj 113) s. Graphik im Kalendarium INr 132014, Obj 5",
      "content_type": [],
      "created": "2026-06-11 10:18:51.630Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "11",
      "incipit_statement": "Elisa gieng an einem Nachmittage in einen kleine Birkenwald, Ihr Hermann war nur einige Tage abwesend gewesen",
      "language": [],
      "musenalm_id": 132022,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I.",
      "updated": "2010-01-22 00:00:00.000Z",
      "variant_title": "",
      "year": 1799,
      "editor": "",
      "agents": [],
      "source_id": "gju7582ec3jw1xr"
    },
    {
      "annotation": "Erklärung der Kupfer (Sammlung INr 132021, Obj 113) s. Graphik im Kalendarium INr 132015, Obj 6",
      "content_type": [],
      "created": "2026-06-11 10:18:51.630Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "11",
      "incipit_statement": "Vom milden Strahle der untergehenden Sonne beleuchtet, sitzt Elisa in Wehmut versinken;",
      "language": [],
      "musenalm_id": 132023,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II.",
      "updated": "2010-01-22 00:00:00.000Z",
      "variant_title": "",
      "year": 1799,
      "editor": "",
      "agents": [],
      "source_id": "i7j973gzr0wp72w"
    },
    {
      "annotation": "Erklärung der Kupfer (Sammlung INr 132021, Obj 113) s. Graphik im Kalendarium INr 132016, Obj 7",
      "content_type": [],
      "created": "2026-06-11 10:18:51.630Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "12",
      "incipit_statement": "Elisa hatt in einem Walde einen Greis gefunden, der an Kräften erschöpft, niedergesunken war.",
      "language": [],
      "musenalm_id": 132024,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
