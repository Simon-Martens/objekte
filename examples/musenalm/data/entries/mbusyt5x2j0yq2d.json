      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "197",
      "incipit_statement": "So läßt der leider allzufrüh geschiedene edle Körner den Soliman klagend ausrufen, und in der That, hätten nicht Helden, wie Zrini, den die Trümmer des erstürmten Szigeth begruben,",
      "language": [],
      "musenalm_id": 64315,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Familie Lugocz. / Die Welt, die flammende, hätt' ich bezwungen, / Wär' ich der einz'ge Held in meiner Zeit; / Doch große Männer lebten mein Jahrhundert, / Und große Helden standen wider mich!",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "J. Schäfer",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Familie Lugocz. / Die Welt, die flammende, hätt' ich bezwungen, / Wär' ich der einz'ge Held in meiner Zeit; / Doch große Männer lebten mein Jahrhundert, / Und große Helden standen wider mich!",
      "updated": "2009-05-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1858,
      "editor": "",
      "agents": [],
