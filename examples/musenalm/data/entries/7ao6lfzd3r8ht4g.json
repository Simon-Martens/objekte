    {
      "annotation": "Vorwort des Herausgebers s. Titelgraphik INr 431222, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:17:41.427Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Der Roman und die Reisebeschreibung ringen jetzt auf dem großen Schauplatze der lesenden Welt miteinander um den Preis.",
      "language": [],
      "musenalm_id": 41223,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Einleitung. / Ueber den Vorzug der neueren Reisemethoden / vor denen der Alten",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "E. A. W. Zimmermann",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Einleitung. / Ueber den Vorzug der neueren Reisemethoden / vor denen der Alten",
      "updated": "2005-11-07 00:00:00.000Z",
