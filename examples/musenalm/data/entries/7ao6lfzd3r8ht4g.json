    {
      "annotation": "s. Graphiken u. Karte INr 41229-412443, 41245; Obj 10-25",
      "content_type": [],
      "created": "2026-06-11 10:17:41.428Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "23",
      "incipit_statement": "Schon den Alten war dieser Welttheil das Reich des Wunderbaren; und jeder Schritt, den die Neueren darin vorwärts thun, bestärkt jene Behauptung.",
      "language": [],
      "musenalm_id": 41224,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
