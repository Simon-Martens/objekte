      "content_type": [],
      "created": "2026-06-11 10:18:48.341Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "Die Erfindung des Clavecin, oder wie wir dieses Instrument im Deutschen nennen, des befiederten Flügels ist ungewiß;",
      "language": [],
      "musenalm_id": 123212,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
