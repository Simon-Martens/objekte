      "content_type": [],
      "created": "2026-06-11 10:18:48.363Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Unter den neuern musikalischen Erfindungen zeichnet sich unsbesondere die Erfindung der sogenannten Duodramen aus,",
      "language": [],
      "musenalm_id": 123208,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "7.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "7.",
      "updated": "2008-03-06 00:00:00.000Z",
      "variant_title": "",
      "year": 1782,
