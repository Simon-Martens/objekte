      "agents": [],
      "source_id": "yhxkzkw4fnbtqoi"
    },
    {
      "annotation": "I. Erfindungen, die Musik betreffend (Sammlung INr 123201, Obj 4)",
      "content_type": [],
      "created": "2026-06-11 10:18:48.341Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "28",
      "incipit_statement": "In den Jahren 1713-1715 studirte in Leipzig Herr Pantaleon Hebenstreit, der im Clavierspielen und Tanzen Unterricht gab.",
      "language": [],
      "musenalm_id": 123214,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "13.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "13.",
