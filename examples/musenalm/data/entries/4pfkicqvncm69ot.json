      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "26",
      "incipit_statement": "Im Jahr 1752 ungefehr, erfand ein Bürgermeister zu Einbeck, Namens Unger, eine Maschine, vermittelst welcher sich von selbst alles aufzeichnet, was man auf einem Clavierinstrumente, an welchem eine solche Maschine angebracht ist, phantasiert.",
      "language": [],
      "musenalm_id": 123213,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "12.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "12.",
      "updated": "2008-03-06 00:00:00.000Z",
