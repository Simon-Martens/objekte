      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Unserere jetzt gewöhnlichen Noten sind von Johann de Muris aus Paris, im Jahre 1330 erfunden worden.",
