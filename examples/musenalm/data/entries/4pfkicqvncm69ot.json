      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "2",
      "incipit_statement": "In eben dieser Zeit ungefehr, hat Dunstan, ein Engländer, zuerst angefangen mit mehrern Stimmen zu componiren.",
      "language": [],
      "musenalm_id": 123204,
      "musenalm_pagination": [
