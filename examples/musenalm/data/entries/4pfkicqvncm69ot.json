      "editor": "",
      "agents": [],
      "source_id": "kyb663sy3jh7xf0"
    },
    {
      "annotation": "I. Erfindungen, die Musik betreffend (Sammlung INr 123201, Obj 4)",
      "content_type": [],
      "created": "2026-06-11 10:18:48.341Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "6",
      "incipit_statement": "Unter den Verbesserungen, die von Zeit zu Zeit mit dem Clavichorde vorgenommen worden, sind hauptsächlich diejenigen merkwürdig, die wir dem Herrn Carl Lemme, Organist an der Catharinen- und Magni-Kirche in Braunschweig zu danken haben.",
      "language": [],
      "musenalm_id": 123211,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "10.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "10.",
      "updated": "2008-03-06 00:00:00.000Z",
      "variant_title": "",
      "year": 1782,
      "editor": "",
      "agents": [],
      "source_id": "jl9j9ns1tbfpdui"
    },
    {
