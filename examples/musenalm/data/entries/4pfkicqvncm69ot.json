      "source_id": "m6f3dbofeb70p9y"
    },
    {
      "annotation": "I. Erfindungen, die Musik betreffend (Sammlung INr 123201, Obj 4)",
      "content_type": [],
      "created": "2026-06-11 10:18:48.363Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Der Pater Marcus Antonius Cesti, ein Mönch aus dem Kloster zu Arezzo, und des Kaiser Ferdinands III. Kapellmeister, soll ebenfalls im Anfange des 17ten Jahrhunderts das Recitativ erfunden haben.",
      "language": [],
      "musenalm_id": 123207,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "6.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "6.",
      "updated": "2008-03-06 00:00:00.000Z",
      "variant_title": "",
      "year": 1782,
      "editor": "",
      "agents": [],
      "source_id": "5jver6glxsmkyni"
    },
    {
