      "agents": [],
      "source_id": "94v7cxbe7rplfhy"
    },
    {
      "annotation": "I. Erfindungen, die Musik betreffend (Sammlung INr 123201, Obj 4)",
      "content_type": [],
      "created": "2026-06-11 10:18:48.366Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "4",
      "incipit_statement": "Die Erfindung der Orgeln ist nicht genau zu bestimmen; sie ist aber nach der besten Schriftsteller Meynung bei den Griechen, wo nicht gar bey den Hebräern zu suchen.",
      "language": [],
      "musenalm_id": 123209,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "8.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "8.",
      "updated": "2008-03-06 00:00:00.000Z",
      "variant_title": "",
      "year": 1782,
      "editor": "",
      "agents": [],
      "source_id": "ba12605onllj28x"
    },
    {
      "annotation": "I. Erfindungen, die Musik betreffend (Sammlung INr 123201, Obj 4)",
      "content_type": [],
      "created": "2026-06-11 10:18:48.341Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "5",
      "incipit_statement": "Die Clavichorde sollen zwar, wie Prinz und mehrere meynen, von Guido Aretinus erfunden seyn,",
      "language": [],
      "musenalm_id": 123210,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "9.",
      "pseudonym": false,
