      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Die Erfindung der geistlichen Oratorien gehört in die allerältesten Zeiten.",
      "language": [],
      "musenalm_id": 123206,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
