      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Ueber die Salzquellen im Sulzthal des / Cantons Aargau. Vorgelesen in der / Sitzung vom 24. Jenner 1815 der / staatswissenschaftlichen Klasse der Ge- / sellschaft für vaterländische Kultur. Von / Herrn Oberforst- und Berg-Inspektor / Zschokke",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Herr Oberforst- und Berg-Inspektor Zschokke",
