    {
      "annotation": "Es folgen: 4 Beiträge INr 82770-82773, Obj 8-11",
      "content_type": [],
      "created": "2026-06-11 10:18:24.610Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "19",
      "incipit_statement": "Vielleicht sind diese Fragmente nicht ganz unwill- / kommen, da sie Gegenden betreffen, welche noch wenig von unsern zahlreichen Reisedilettanten be- / sucht worden, obwohl sie historisches Interesse haben.",
      "language": [],
      "musenalm_id": 82769,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. / Fragmente zur Geschichte der / Vorzeit, gesammelt auf ei- / ner Wanderung über ver- / schiedene Berghöhen in den / Kantonen Basel und Solo- / thurn.",
      "pseudonym": false,
