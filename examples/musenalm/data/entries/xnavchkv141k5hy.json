    {
      "annotation": "Dem Text vorangestellt: O zarte Sehnsucht, süßes Hoffen, / Der ersten Liebe goldene Zeit, [..] Schiller",
      "content_type": [],
      "created": "2026-06-11 10:18:35.107Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "93",
      "incipit_statement": "Es hatte kaum sechs Uhr geschlagen, als der Schulamtscandidat Günther die vielen Treppen, welche von seinem bescheidenen Dachstübchen zu Erde führten, leichten Schrittes und Herzens hinabeilte.",
      "language": [],
      "musenalm_id": 103332,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Zwei Tage. / Lebensbild",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Maria Roskowska",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Zwei Tage. / Lebensbild",
      "updated": "2010-03-12 00:00:00.000Z",
      "variant_title": "",
      "year": 1858,
      "editor": "",
      "agents": [],
      "source_id": "d05etfkg2ascyqx"
    },
    {
      "annotation": "",
