    {
      "annotation": "Geschichte des heutigen Europa, vom fünften bis zum achtzehnten Jahrhunderte (Sammlung INr 82671, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:25.795Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Da wir gesinnet sind, in einer ununterbrochenen jährlichen Ausgabe von historischen Taschenkalendern die Geschichte des heutigen Europa abzuhandeln, so setzen wir den ganzen Umfang der alten Geschichte als bekannt voraus.",
      "language": [],
      "musenalm_id": 82672,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Geschichte / des heutigen Europa. / Erste Abhandlung. / Uibersicht von Europa nach dem Ver- / fall des römischen Reiches, nebst den / Ursachen und Folgen desselben.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Geschichte / des heutigen Europa. / Erste Abhandlung. / Uibersicht von Europa nach dem Ver- / fall des römischen Reiches, nebst den / Ursachen und Folgen desselben.",
      "updated": "2011-09-08 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "eb7lqpl7mym1ddo"
    },
    {
      "annotation": "Geschichte des heutigen Europa, vom fünften bis zum achtzehnten Jahrhunderte (Sammlung INr 82671, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:23.411Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "23",
      "incipit_statement": "Die alten Gallier, Britannier, Germanen, Skandinavier, und alle Nazionen des nördlichen Europa, hatten einen gewissen Grad der Gleichförmigkeit in ihrer Regierungsform sowohl, als in ihren Sitten und Meinungen.",
      "language": [],
      "musenalm_id": 82673,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Zweite Abhandlung. / Das System der Staatsverfassung und / Gesetzgebung, welches die Barbaren einführten, als sie sich in den rö- / mischen Provinzen niederließen.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Zweite Abhandlung. / Das System der Staatsverfassung und / Gesetzgebung, welches die Barbaren einführten, als sie sich in den rö- / mischen Provinzen niederließen.",
      "updated": "2011-09-08 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "wcqvhfb51xi0wq2"
    },
    {
      "annotation": "Geschichte des heutigen Europa, vom fünften bis zum achtzehnten Jahrhunderte (Sammlung INr 82671, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:23.411Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "32",
      "incipit_statement": "In der Geschichte sowohl als in allen übrigen Wissenschaften, ist es nothwendig, unsern Untersuchungen gewisse Gränzen zu setzen,",
      "language": [],
      "musenalm_id": 82674,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Dritte Abhandlung. Das feste Land von Europa, von der / Niederlassung der neuern Nazionen / an bis zu den Zeiten Karls des / Großen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Dritte Abhandlung. Das feste Land von Europa, von der / Niederlassung der neuern Nazionen / an bis zu den Zeiten Karls des / Großen",
      "updated": "2011-09-08 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "zs83h2b94qvqjb9"
    },
    {
      "annotation": "Geschichte des heutigen Europa, vom fünften bis zum achtzehnten Jahrhunderte (Sammlung INr 82671, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:23.411Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "83",
      "incipit_statement": "Die Angelegenheiten dieser berühmten Insel fordern unsere ganze Aufmerksamkeit. Sie wurde um das Jahr 448 von den Römern verlassen,",
      "language": [],
      "musenalm_id": 82675,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Vierte Abhandlung. / Britannien / von der Zeit da es die Römer ver- / ließen, bis zu dem Ende der sächsischen / Heptarchie",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Vierte Abhandlung. / Britannien / von der Zeit da es die Römer ver- / ließen, bis zu dem Ende der sächsischen / Heptarchie",
      "updated": "2011-09-08 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "p5lj1xm9f8ss91q"
    },
    {
      "annotation": "Geschichte des heutigen Europa, vom fünften bis zum achtzehnten Jahrhunderte (Sammlung INr 82671, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:23.411Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "97",
      "incipit_statement": "Hätten die Sachsen, bei ihrer Niederlassung in Britannien, eben die Regierungsform eingeführt, welche wir bei den andern nördlichen Nazionen, die sich der römischen Provinzen bemächtigten, haben kennengelernt, so würde diese Abhandlung höchst überflüssig",
      "language": [],
      "musenalm_id": 82676,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Fünfte Abhandlung. / Die Verfassung, Gesetze und Sitten / der Sachsen in Britannien",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Fünfte Abhandlung. / Die Verfassung, Gesetze und Sitten / der Sachsen in Britannien",
      "updated": "2011-09-08 00:00:00.000Z",
      "variant_title": "",
      "year": 1788,
      "editor": "",
      "agents": [],
      "source_id": "a95p5vqvk7oinq5"
    },
    {
      "annotation": "Geschichte des heutigen Europa, vom fünften bis zum achtzehnten Jahrhunderte (Sammlung INr 82671, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:24.189Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "107",
      "incipit_statement": "Karl und Karlmann, die beiden Söhne Pipins und seine Nachfolger, waren Männer von sehr verschiedenem Charakter.",
      "language": [],
      "musenalm_id": 82677,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Sechste Abhandlung. / Die Regierung Karls des Großen, Königs von Frankreich und Kaisers / von Okzident",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Sechste Abhandlung. / Die Regierung Karls des Großen, Königs von Frankreich und Kaisers / von Okzident",
      "updated": "2011-09-08 00:00:00.000Z",
      "variant_title": "",
