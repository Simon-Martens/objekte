    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:51.535Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Berechne, wenn einst mein Herz, voll Liebe zu Dir, in Deinen Armen Dir zum letztenmal schlägt, berechne dann, süßes Weib, mit diesem Almanach in der Hand, die irdische Dauer unsers stillen häuslichen Lebens -",
      "language": [],
      "musenalm_id": 129102,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Widmung"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Amalien, / der / Gefährtin meines Lebens, / gewidmet",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Amalien, / der / Gefährtin meines Lebens, / gewidmet",
      "updated": "2010-02-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1802,
      "editor": "",
      "agents": [],
      "source_id": "lq2zmexk3f6gw81"
    },
    {
      "annotation": "Vorwort des Herausgebers",
      "content_type": [],
      "created": "2026-06-11 10:18:51.536Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "Die Fortsetzung dieses Almanachs geschieht dem Versprechen gemäß, welches ich bereits bei der Herausgabe des vorjährigen gemacht.",
      "language": [],
      "musenalm_id": 129103,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
