      "editor": "",
      "agents": [],
      "source_id": "vpzxcl5h57hoa4x"
    },
    {
      "annotation": "Erklärung der Kupfer (Sammlung INr 129104, Obj 7) § bez. Graphik fehlt",
      "content_type": [],
      "created": "2026-06-11 10:18:50.986Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "13",
      "incipit_statement": "Seit einigen Jahren hat das Wohlwollen und der Geschmack des Herrn Cammerraths Frege, jetzigen Besitzers von Abtnaundorf, diesen sonst völlig unbemerkten Ort,",
      "language": [],
      "musenalm_id": 129107,
      "musenalm_pagination": [
