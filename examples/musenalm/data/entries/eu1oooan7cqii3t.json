    {
      "annotation": "Kupfererklärung (Sammlung INr 63445, Obj 3) s. Titelportrait INr 63443, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:18:12.292Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Alexandine Victoire, Kronprinzessin von England, geboren den 24. Mai 1819; Tochter des verstorbenen Herzogs von Kent,",
      "language": [],
      "musenalm_id": 63446,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. Titelkupfer",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. Titelkupfer",
      "updated": "2009-04-17 00:00:00.000Z",
      "variant_title": "",
      "year": 1833,
      "editor": "",
      "agents": [],
      "source_id": "a9p5bm0b3jytfd9"
    },
    {
      "annotation": "Kupfererklärung (Sammlung INr 63445, Obj 3) s. Graphik INr 63455, Obj 13",
      "content_type": [],
      "created": "2026-06-11 10:18:11.961Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Vor alter grauer Zeit beschlossen die Bürger Aachens eine Kirche zu bauen. Rasch begann das Werk, und fleißige Hände förderten es - da versagten die Mittel",
      "language": [],
      "musenalm_id": 63447,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. Der Kirchenbau in Aachen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. Der Kirchenbau in Aachen",
      "updated": "2009-04-17 00:00:00.000Z",
      "variant_title": "",
      "year": 1833,
      "editor": "",
      "agents": [],
      "source_id": "9gh4pwfnq2ezov4"
    },
    {
      "annotation": "Kupfererklärung (Sammlung INr 63445, Obj 3) s. Graphik INr 63456, Obj 14",
      "content_type": [],
      "created": "2026-06-11 10:18:11.961Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "2",
      "incipit_statement": "In den furchtbaren Fehdezeiten des Mittelalters lebte Bligger von Steinach, genannt der Landschaden, in schon altergrauer, unzugänglicher Burg, das Schwalbennest geheißen,",
      "language": [],
      "musenalm_id": 63448,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "III. Landschaden von Steinach",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "III. Landschaden von Steinach",
      "updated": "2009-04-17 00:00:00.000Z",
      "variant_title": "",
      "year": 1833,
      "editor": "",
      "agents": [],
      "source_id": "b9cxvbxkw6snoqf"
    },
    {
      "annotation": "Kupfererklärung (Sammlung INr 63445, Obj 3) s. Graphik INr 63457, Obj 15",
      "content_type": [],
      "created": "2026-06-11 10:18:11.961Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "3",
      "incipit_statement": "Die Burg zu Lauf, eigentlich Neuwindeck genannt, soll vor ihrer Zerstörung lange unbewohnt gewesen seyn, wegen des Geisterspuks, der sich Tag und Nacht darin hören ließ.",
      "language": [],
      "musenalm_id": 63449,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "IV. Die todte Braut",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "IV. Die todte Braut",
      "updated": "2009-04-17 00:00:00.000Z",
      "variant_title": "",
      "year": 1833,
      "editor": "",
      "agents": [],
      "source_id": "wl474crwcd1dh3c"
    },
    {
      "annotation": "Kupfererklärung (Sammlung INr 63445, Obj 3) s. Graphik INr 63458, Obj 16",
      "content_type": [],
      "created": "2026-06-11 10:18:11.961Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "4",
      "incipit_statement": "Rheinau gegenüber lag einst das feste Schloß Baden, von einem uralten Geschlecht bewohnt.",
      "language": [],
      "musenalm_id": 63450,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "V. Die Burgfrau von Baden",
      "pseudonym": false,
