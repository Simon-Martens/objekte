        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Vom l'Hombre en quatre, oder Kauf- / quadrille",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Vom l'Hombre en quatre, oder Kauf- / quadrille",
