      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "9",
      "incipit_statement": "Dies Leben gleicht den Jahreszeiten / Der Frühling ist die Zeit der Saat, / Der schmeckt der Erndte Süßigkeiten, / Der ihn dazu genützet hat.",
      "language": [],
      "musenalm_id": 129667,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Jahreszeiten",
      "pseudonym": false,
