      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "An den Frühling",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "An den Frühling",
