      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "148",
      "incipit_statement": "Während der Oratorienzeit pflegte Händel die besten Musiker seines Orchesters bisweilen zum Mittagessen zu bitten.",
      "language": [],
      "musenalm_id": 122878,
      "musenalm_pagination": [
