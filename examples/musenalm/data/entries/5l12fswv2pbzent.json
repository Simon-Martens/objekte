      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "149",
      "incipit_statement": "Als Gluck zuerst im Jahre 1745 nach England kam. wurde Händel gefragt, was er von ihm hielte.",
      "language": [],
      "musenalm_id": 122880,
      "musenalm_pagination": [
