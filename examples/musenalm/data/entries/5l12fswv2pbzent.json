      "agents": [],
      "source_id": "0t8cmlotwhkio52"
    },
    {
      "annotation": "VI. Einige Anecdoten, hauptsächlich von Händel (Sammlung INr 123873, Obj 8)",
      "content_type": [],
      "created": "2026-06-11 10:18:45.160Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "147",
      "incipit_statement": "Auf seiner Reise nach Irland, wurde Händel in Chester einige Tage aufgehalten,",
      "language": [],
      "musenalm_id": 122876,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "3.",
      "pseudonym": false,
      "publication_statement": "",
