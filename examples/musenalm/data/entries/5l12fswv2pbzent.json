      "agents": [],
      "source_id": "mlg20ix6e80qdi0"
    },
    {
      "annotation": "VI. Einige Anecdoten, hauptsächlich von Händel (Sammlung INr 123873, Obj 8)",
      "content_type": [],
      "created": "2026-06-11 10:18:46.817Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "147",
      "incipit_statement": "Wenn Händel in den Zeiten seines Mißgeschicks in London in seinen Opern und Oratorien fast gar keine Zuhörer hatte,",
      "language": [],
      "musenalm_id": 122877,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "4.",
      "pseudonym": false,
