    },
    {
      "annotation": "VI. Einige Anecdoten, hauptsächlich von Händel (Sammlung INr 123873, Obj 8)",
      "content_type": [],
      "created": "2026-06-11 10:18:45.160Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "146",
      "incipit_statement": "Als sich Händel in Dublin aufhielt, hatte an einem Abend ein gewisser Dubourg eine Solostimme zu einer Arie zu spielen,",
      "language": [],
      "musenalm_id": 122875,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "2.",
      "pseudonym": false,
