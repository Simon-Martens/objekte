      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Friedrich Günther",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Verbannten. / Geschichtliche Erzählung",
      "updated": "2010-02-05 00:00:00.000Z",
