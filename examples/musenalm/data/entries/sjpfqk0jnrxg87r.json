    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:35.409Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Langsam und mißmuthig durchritt der König von Spanien, Philipp V. den Prado. Außer einigen nachfolgenden Dienern begleiteten ihn nur zwei Franzosen,",
      "language": [],
      "musenalm_id": 102978,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
