    {
      "annotation": "Beitrag in 3 Briefen mit zahlreichen Einträgen",
      "content_type": [],
      "created": "2026-06-11 10:18:44.617Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "158",
      "incipit_statement": "Sie fordern mich auf, Ihnen einen Einblick in die neueste jüdische Literatur zu verschaffen,",
      "language": [],
      "musenalm_id": 119159,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
