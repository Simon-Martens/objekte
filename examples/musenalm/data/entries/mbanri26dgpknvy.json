    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:44.462Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Nichts bietet dem jüdischen HIstoriker einen höhern Genuß als in der Fülle von Leiden und Verfolgungen, denen er auf jeder Blattseite der Geschichte begegnet, auch einmal ein lichtes Bild der Erhebung und Erhöhung",
      "language": [],
      "musenalm_id": 119152,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Don Manuel Teixera, / Minister-Resident der Königin Christine von Schweden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Dr. M. Kayserling",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Don Manuel Teixera, / Minister-Resident der Königin Christine von Schweden",
      "updated": "2017-05-09 00:00:00.000Z",
