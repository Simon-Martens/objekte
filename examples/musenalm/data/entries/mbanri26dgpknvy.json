    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:44.462Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "14",
      "incipit_statement": "Die österreichische Heeresverfassung ist in religiöser Beziehung durch das Princip der liberalsten und unbeschränktesten Duldsamkeit characterisirt.",
      "language": [],
      "musenalm_id": 119153,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Israeliten in der k.k. österreichischen Armee",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Dr. W. Derblich",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Israeliten in der k.k. österreichischen Armee",
      "updated": "2017-05-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1860,
      "editor": "",
      "agents": [],
      "source_id": "0w1y9h4z2y4hs64"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:44.230Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "24",
      "incipit_statement": "Zu einer Zeit, wo die Geldmacht zur ersten Großmacht geworden, vor der Alles im Staube liegt, wo der Geburtsadel vor dem Geldadel sich beugt, und selbst Fürsten gezwungen sind, ihre Herrschaft anzuerkennen;",
      "language": [],
      "musenalm_id": 119154,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Plutokratie und das Judenthum",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "A. Kohn, Kreisrabbiner",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Plutokratie und das Judenthum",
      "updated": "2017-05-09 00:00:00.000Z",
      "variant_title": "",
      "year": 1860,
      "editor": "",
      "agents": [],
      "source_id": "gsfsjlalc65c6pt"
    },
    {
      "annotation": "mit zahlreichen Einträgen",
      "content_type": [],
      "created": "2026-06-11 10:18:44.230Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "64",
      "incipit_statement": "Wir gehen diesmal an unsere Umschau mit dankbar gehobener Brust; denn es sind große Fortschritte der Civilisation, es ist eine bedeutende Entwicklung der Rechtsbegriffe zu Gunsten unserer Glaubensgenossen,",
      "language": [],
      "musenalm_id": 119155,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Rückblicke auf das verflossene Jahr",
      "pseudonym": false,
      "publication_statement": "",
