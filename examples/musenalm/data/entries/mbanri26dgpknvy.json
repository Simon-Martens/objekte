      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Dr. B. Beer",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Rückblicke auf die jüdische Literatur seit Mai 1859, in Briefen an einen Freund",
      "updated": "2017-05-09 00:00:00.000Z",
      "variant_title": "",
