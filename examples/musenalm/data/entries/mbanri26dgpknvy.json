      "created": "2026-06-11 10:18:44.230Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "122",
      "incipit_statement": "Wir geben einem von mehreren Seiten an uns gerichteten Wunsche nach, indem wir dieser Rubrik aufs Neue Raum verstatten.",
      "language": [],
      "musenalm_id": 119156,
      "musenalm_pagination": [
