    {
      "annotation": "Miniatur-Salon. Ausstellung 1858 (Sammlung INr 44617, Obj 5) dem Text vorangestellt: Wie der Meister, so die Schüler; s. Graphik INr 44618, Obj 7",
      "content_type": [],
      "created": "2026-06-11 10:18:01.820Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "An der Spitze der k. Akademie der bildenden Künste in München steht bekanntlich eine Persönlichkeit, welch sich der Genius der Kunst als ein bevorzugtes Organ weitreichender Wirksamkeit erkoren hat.",
      "language": [],
      "musenalm_id": 44619,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das Gebet für die kranke Mutter. / Von Theodor Pixis",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das Gebet für die kranke Mutter. / Von Theodor Pixis",
      "updated": "2006-08-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1858,
      "editor": "",
      "agents": [],
      "source_id": "icr73dvwrvmo55r"
    },
    {
      "annotation": "Miniatur-Salon. Ausstellung 1858 (Sammlung INr 44617, Obj 5) s. Graphik INr 44615, Obj 4",
      "content_type": [],
      "created": "2026-06-11 10:18:01.820Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "10",
      "incipit_statement": "Kein tragisches Motiv der Geschichte mag wohl öfter zu dramatischer oder bildlicher Darstellung ausgebeutet worden sein, als das traurige Schicksal und gewaltsame Ende Conradin's von Schwaben und seines edlen Freundes Friedrich von Baden.",
      "language": [],
      "musenalm_id": 44620,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Todesurtheils-Verkündigung an Conradin von schwaben / und Friedrich von Baden. / Gemälde von Joseph Munsch",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Todesurtheils-Verkündigung an Conradin von schwaben / und Friedrich von Baden. / Gemälde von Joseph Munsch",
      "updated": "2006-08-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1858,
      "editor": "",
      "agents": [],
      "source_id": "a5t1ptxa8a1utm6"
    },
