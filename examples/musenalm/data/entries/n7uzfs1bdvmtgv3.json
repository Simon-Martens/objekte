      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / An die / Braven, / die Freyheit und Vaterland überlebten",
      "pseudonym": false,
      "publication_statement": "",
