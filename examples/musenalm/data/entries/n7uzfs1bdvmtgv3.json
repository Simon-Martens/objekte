      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "53",
      "incipit_statement": "Wir zeichnen erst diese wichtigste Begebenheit des verflossenen Jahres aus und stellen sie in das Licht, und dann fügen wir über jenen Gedanken und Vorsatz das Nöthigste hinzu.",
      "language": [],
      "musenalm_id": 60500,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "III. / Politisch-moralische Rede, gehalten / am ersten Tage des zweyten Jahres / des neuen Jahrhunderts. / Zu welchem Gedanken und Vorsatze sollten / die Völker Europens bey dem Andenken / an die wichtigste Begebenheit des verwiche- / nen Jahres am ersten Tage des angehen- / den ihren Geist sammeln?",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "III. / Politisch-moralische Rede, gehalten / am ersten Tage des zweyten Jahres / des neuen Jahrhunderts. / Zu welchem Gedanken und Vorsatze sollten / die Völker Europens bey dem Andenken / an die wichtigste Begebenheit des verwiche- / nen Jahres am ersten Tage des angehen- / den ihren Geist sammeln?",
      "updated": "2008-10-21 00:00:00.000Z",
      "variant_title": "",
      "year": 1804,
      "editor": "",
