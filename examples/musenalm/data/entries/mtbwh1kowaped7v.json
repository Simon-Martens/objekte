    {
      "annotation": "s. Titelportrait INr 118084, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:18:45.906Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "",
      "incipit_statement": "Ein dichtbelaubter Baum, welchen der Blitz zersplittert, ein Saatfeld, das der Hagel vernichtend niederwarf, eine Blume, mit  Eins vom Wüthen des Sturmes geknickt, erregen ein unnennbar wehmüthiges Gefühl;",
      "language": [],
      "musenalm_id": 118090,
      "musenalm_pagination": [],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Erzherzogin Mathilde",
      "pseudonym": false,
