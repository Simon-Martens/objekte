      "year": 1799,
      "editor": "",
      "agents": [],
      "source_id": "qphm5t8cdqpvb0q"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:21.467Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "109",
      "incipit_statement": "Nicht ein Roßtauscherrecht, sondern eine zusammengedrängte Darstellung des Praktischen aus dieser Wissenschaft soll und kann der gegenwärtige Aufsatz enthalten.",
