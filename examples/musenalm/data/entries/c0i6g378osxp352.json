    },
    {
      "annotation": "<div>&nbsp;Die Schenke des Invaliden. Sitten und Lebensbilder der russischen Völker<br><br></div>",
      "content_type": [],
      "created": "2026-09-16 09:01:39.096Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "203",
      "incipit_statement": "Bogdan war der Erste, der diesen Abend erschien, Anna trat ihm freundlich entgegen, zog ihn in einen Winkel und sprach gerührt: Du bist brav Bogdan,…",
      "language": [],
      "musenalm_id": 140586,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Dritter Abend",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Dritter Abend",
