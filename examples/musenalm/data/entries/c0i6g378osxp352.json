    {
      "annotation": "<div>Die Schenke des Invaliden. Sitten und Lebensbilder der russischen Völker<br>(2 Kapitel)</div>",
      "content_type": [],
      "created": "2026-09-16 08:55:00.516Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "Herr erbarme Dich! Hundert neun und achtzig. Herr erbarme Dich! Hundert neunzig. Der Beter schlägt nunmehr mit der Stirn zur Erde…",
      "language": [],
      "musenalm_id": 140582,
      "musenalm_pagination": [
