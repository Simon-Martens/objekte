    },
    {
      "annotation": "<div>&nbsp; Die Schenke des Invaliden. Sitten und Lebensbilder der russischen Völker&nbsp;</div>",
      "content_type": [],
      "created": "2026-09-16 09:00:07.294Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "193",
      "incipit_statement": "Es war am folgenden Tage, der Abend dämmerte bereits, als Adrijana aus der Thüre treten wollte und erschrocken zurück fuhr.",
      "language": [],
      "musenalm_id": 140585,
      "musenalm_pagination": [
