      "agents": [],
      "source_id": "snvn7b0759f2khk"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-09-16 09:04:44.382Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "223",
      "incipit_statement": "Adrijana saß mit roth geweinten Augen an der Spindel, auch die Mutter schmollte, denn Iisidor hatt sich die ganze Woche nicht sehen lassen;",
      "language": [],
      "musenalm_id": 140587,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
