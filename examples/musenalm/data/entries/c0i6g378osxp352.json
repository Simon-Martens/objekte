      "editor": "gpj6tpa1lmk3vpy",
      "agents": [],
      "source_id": "90og3lcl9d0776q"
    },
    {
      "annotation": "<div>&nbsp;Die Schenke des Invaliden. Sitten und Lebensbilder der russischen Völker<br>(6 Kapitel)&nbsp;</div>",
      "content_type": [],
      "created": "2026-09-16 08:58:48.693Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "107",
      "incipit_statement": "Es war wieder Sonnabend; draußen stürmte das winterliche Herbstwetter…",
      "language": [],
      "musenalm_id": 140584,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
