    },
    {
      "annotation": "<div>&nbsp;Die Schenke des Invaliden. Sitten und Lebensbilder der russischen Völker<br>(5 Kapitel)&nbsp;</div>",
      "content_type": [],
      "created": "2026-09-16 08:57:05.566Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "25",
      "incipit_statement": "Es ist nun Sonnabend; der kleine Tisch ist übervoll mit Flaschen, Gläsern und einer mächtigen Fischpirogge bedeckt.…",
      "language": [],
      "musenalm_id": 140583,
      "musenalm_pagination": [
