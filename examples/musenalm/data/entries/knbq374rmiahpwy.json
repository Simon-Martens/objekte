    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:25.927Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "49",
      "incipit_statement": "Nächst der Holzbenutzung aus Nadelwäldern als Hauptzweig, besonders wenn sie aus Kiefern - Pinus sylvestris - und Fichten - Pinus Picea - bestehen, ist die Theer- Harz- Kienrus- Kienöl- und Gärberlohe-Nutzung ein wichter Nebenzweig des Forstertrages,",
      "language": [],
      "musenalm_id": 89324,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "III. / Anleitung / zur / Theerschwelerey und zum Kienrus- / brennen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "III. / Anleitung / zur / Theerschwelerey und zum Kienrus- / brennen",
      "updated": "2009-08-19 00:00:00.000Z",
