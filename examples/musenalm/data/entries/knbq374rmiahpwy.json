      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Bericht / von / drey verschiedenen Baumarten, / welche / für England sowohl zu Zierbäumen, als / auch zu Bau- und Nutzholze mit dem / größten Vortheile erzogen werden / können",
      "pseudonym": false,
