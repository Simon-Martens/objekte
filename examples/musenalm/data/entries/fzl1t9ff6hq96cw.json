    {
      "annotation": "Dem Text vorangestellt: Uns ist in altem Mären Wunders viel gefait / Von Helden, werth der Ehren, von großer Kühnheit;",
      "content_type": [],
      "created": "2026-06-11 10:18:38.172Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "7",
      "incipit_statement": "Fern von der Arbeit der Knechte ergötzte den Ritter, wenn er auf seiner Burg hauste, die ritterliche Luft der Jagd, oder ein heiteres Bankett, wo der Wein in Strömen floß",
      "language": [],
      "musenalm_id": 103588,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Ein modernes Bild / aus der / romantischen Zeit / des / Ritterthums",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Ein modernes Bild / aus der / romantischen Zeit / des / Ritterthums",
      "updated": "2010-03-12 00:00:00.000Z",
      "variant_title": "",
      "year": 1849,
      "editor": "",
      "agents": [],
      "source_id": "osipb48lseg5277"
    },
    {
      "annotation": "mit Anm.",
      "content_type": [],
      "created": "2026-06-11 10:18:38.172Z",
