      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "5",
      "incipit_statement": "Es lag schon früher in unserm Plane, dem deutschen Volke in dem alljährlich wiederkehrenden Almanach einmal das Leben und Treiben unserer Vorfahren im Mittelalter durch einen Cyclus von Darstellungen zu veranschaulichen",
      "language": [],
      "musenalm_id": 103587,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
