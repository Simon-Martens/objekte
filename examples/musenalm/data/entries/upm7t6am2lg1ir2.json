    {
      "annotation": "SS 11-14 fehlen, SS 15 ff mit numerierten Beiträgen No.8 - No.15; wahrscheinlich Textbezüge zu den Modekupfern",
      "content_type": [],
      "created": "2026-06-11 10:18:10.035Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Je höher eine Sache hinauf gestiegen ist, zur Stufe der Vollkommenheit, desto gewisser, desto schrecklicher ist ihr Fall.",
      "language": [],
      "musenalm_id": 56619,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Etwas über den heutigen / Modezustand",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Etwas über den heutigen / Modezustand",
