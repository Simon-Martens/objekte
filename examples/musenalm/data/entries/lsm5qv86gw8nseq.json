    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.107Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "44",
      "incipit_statement": "Woher mag es wohl kommen, daß die meisten Menschen, so gerne dem anhängen, was glänzt und schimmert?",
      "language": [],
      "musenalm_id": 131542,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Ueber die Wirkung des Aeus- / serlichen in der Freundschaft / und Liebe",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Ueber die Wirkung des Aeus- / serlichen in der Freundschaft / und Liebe",
