      "source_id": "q8tpzoec2460b2j"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.107Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "47",
      "incipit_statement": "Welche sowohl im Bad, als auf Reisen sehr bequem ist zum Tragen beym Spazierengehen, Tanzen, Fahren und Reiten, wenig Zeit zum Anziehen erfordert, den Körper ziert,",
      "language": [],
      "musenalm_id": 131543,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Eine Bad-Uniform für Damen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Eine Bad-Uniform für Damen",
      "updated": "2022-11-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1793,
      "editor": "",
      "agents": [],
      "source_id": "wgqe1je8ofabbj8"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.107Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "48",
      "incipit_statement": "Manche Schöne, die in dem gewähltesten Putze anzieht und gefällt, erregt Widerwillen, sobald sie ihren Putz abgelegt hat,",
      "language": [],
      "musenalm_id": 131544,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Warum etwas ein Frauenzimmer / gut kleiden, und verstellen kann.",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Warum etwas ein Frauenzimmer / gut kleiden, und verstellen kann.",
      "updated": "2022-11-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1793,
      "editor": "",
      "agents": [],
      "source_id": "et0afghvbkdch51"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.108Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "50",
      "incipit_statement": "Ein edles Weibchen ist doch immer ein Inbegriff aller Vortrefflichkeiten - oder kann es seyn, sobald der Wille dazu da ist!",
      "language": [],
      "musenalm_id": 131547,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Schilderung der erhabnen Vorzü- / ge des schönen Geschlechts",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [
        "alm_776_131547_6br4pctbav.jpg"
      ],
      "subtitle_statement": "",
      "title_statement": "Schilderung der erhabnen Vorzü- / ge des schönen Geschlechts",
      "updated": "2022-11-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1793,
      "editor": "",
      "agents": [],
      "source_id": "lelwntxvkijg7nt"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.110Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "54",
      "incipit_statement": "Zwey  Mädchen, gleich an Schönheit und an Jah- / ren, / Denn beyde waren noch nicht 18 Jahre alt; / Sie waren ihrer Eltern einzig Kind",
      "language": [],
      "musenalm_id": 131548,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die zwey vertrauten Mädchen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Graver",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die zwey vertrauten Mädchen",
      "updated": "2022-11-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1793,
      "editor": "",
      "agents": [],
      "source_id": "o423rbl0fzzx6n4"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.110Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "56",
      "incipit_statement": "Lang hast du den Nesselnkranz geschlungen / Um mein jugendliches Haupt,",
      "language": [],
      "musenalm_id": 131549,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Lied / an die / Schwermuth",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Lied / an die / Schwermuth",
      "updated": "2022-11-03 00:00:00.000Z",
      "variant_title": "",
