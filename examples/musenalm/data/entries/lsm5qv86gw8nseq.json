      "agents": [],
      "source_id": "9kd5e934gdmlidm"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.110Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "58",
      "incipit_statement": "Ein Mädchen in ** saß im Gefängniß: Man hatte den Schein eines großen Verbrechens auf sie, und zwar aus Eifersucht und Rache, zu bringen gewußt,",
      "language": [],
      "musenalm_id": 131550,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das vom Tod gerettete Mädchen!",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das vom Tod gerettete Mädchen!",
      "updated": "2022-11-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1793,
      "editor": "",
      "agents": [],
      "source_id": "wga4baelqo65lef"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.111Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "60",
      "incipit_statement": "Vom guten Herzen soll ich singen; / Brich aus mein freudiger Gesang!",
      "language": [],
      "musenalm_id": 131551,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Das / Glück / des guten / Herzens",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Joseph **",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Das / Glück / des guten / Herzens",
      "updated": "2022-11-03 00:00:00.000Z",
      "variant_title": "",
      "year": 1793,
      "editor": "",
      "agents": [],
      "source_id": "x7c9nmc4qtv9e9r"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.111Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "63",
      "incipit_statement": "Goldner Spiegel an der Wand, / Mache mir doch nur bekannt; / Bin ich ein so schönes Kind, / Wie die andern Schönen sind?",
