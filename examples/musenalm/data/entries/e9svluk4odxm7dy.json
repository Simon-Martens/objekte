      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Oft stelle ich mir die Natur, unter dem Bilde eines unermesslichen, dem Herrn geweihten, und von seiner Gottheit erfüllten Tempels vor;",
      "language": [],
      "musenalm_id": 130191,
      "musenalm_pagination": [
        "1. Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Ueber den Frühling / eine geistliche Rede. / Die Werke des Herrn sind gross. / (Ps. III. V. 2.)",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Ueber den Frühling / eine geistliche Rede. / Die Werke des Herrn sind gross. / (Ps. III. V. 2.)",
      "updated": "2010-02-25 00:00:00.000Z",
      "variant_title": "",
      "year": 1796,
      "editor": "",
      "agents": [],
      "source_id": "1hibng78q7vi1xu"
    },
    {
      "annotation": "Geistliche Reden (Sammlung INr 130190, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:52.384Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "28",
      "incipit_statement": "Nichts erhebt den Menschen, dieses schwache dürftige Wesen so sehr, als dass er sich der Gottheit annähern, sich durch den Glauben mit ihr verbinden,",
      "language": [],
      "musenalm_id": 130192,
      "musenalm_pagination": [
        "1. Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. / Ueber das Daseyn Gottes",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. / Ueber das Daseyn Gottes",
