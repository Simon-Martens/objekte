      "place_statement": "",
      "preferred_title": "I. / Von der Schulzucht",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Von der Schulzucht",
