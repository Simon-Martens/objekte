      "source_id": "h892xo7yk6cc9lq"
    },
    {
      "annotation": "mit 6 Kapiteln",
      "content_type": [],
      "created": "2026-06-11 10:18:22.538Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "797",
      "incipit_statement": "Das Büchlein, nach welchem die Konfirmanden unterrichtet werden sollen, enthält erstlich einen Eingang, welcher aus 4 Fragen besteht,",
      "language": [],
      "musenalm_id": 76612,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "II. / Ein kurzer Aufsaz / über das Wirtembergische sogenannte / Konfirmationsbüchlein",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Von einem Ungenannten",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "II. / Ein kurzer Aufsaz / über das Wirtembergische sogenannte / Konfirmationsbüchlein",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1790,
      "editor": "",
      "agents": [],
      "source_id": "aopj1u7ulpo0xor"
    },
    {
      "annotation": "Unter dem Titel: Meistens aus des sel. D. Millers Katechismus und des sel. Pastor Sturms Handlexikon des N. Testaments genommen /) mit zahlreichen Einträgen",
      "content_type": [],
      "created": "2026-06-11 10:18:19.614Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "811",
      "incipit_statement": "Abendmahl bedeutet 1) die von Jesu Christo zu seinem Gedächtnis verordnete Geniessung des Brods und Weins und seines Leibes und Blutes.",
      "language": [],
      "musenalm_id": 76613,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "III. / Kurze Erklärung / biblischer Wörter und Redensarten N. / Test. die oft sehr schwer zu verstehen sind, / oder in unterschiedlichen Stellen einen / ganz verschiedenen Sinn haben",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "III. / Kurze Erklärung / biblischer Wörter und Redensarten N. / Test. die oft sehr schwer zu verstehen sind, / oder in unterschiedlichen Stellen einen / ganz verschiedenen Sinn haben",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1790,
      "editor": "",
      "agents": [],
      "source_id": "2af5qqd948lk2xs"
    },
    {
      "annotation": "mit zahlreichen Einträgen",
      "content_type": [],
      "created": "2026-06-11 10:18:19.614Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "843",
      "incipit_statement": "In gegenwärtiger Zeit ist es unter Männern von Einsicht eine ganz ausgemachte Sache, daß in den teutschen Schulen den Kindern die Bedeutung und Anwendung der in unsrer Sprache üblichen Unterscheidungszeichen erklärt werden solle.",
      "language": [],
      "musenalm_id": 76614,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
