      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "871",
      "incipit_statement": "Am 5ten Nov. 1789 begieng eine kleine Gesellschaft von Schullehrern, mehrentheils aus der Derenburgischen Inspektion, das erste Jahrsfest der von ihr errichteten Schulkonferenz in Dennstädt mit anständiger Feierlichkeit, jedoch ohne alles Geräusche.",
      "language": [],
      "musenalm_id": 76616,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "I. / Schulmeisterkonferenz in dem Halber- / Städtischen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "I. / Schulmeisterkonferenz in dem Halber- / Städtischen",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1790,
      "editor": "",
      "agents": [],
      "source_id": "67ag6itez2tvqx1"
    },
    {
      "annotation": "V. Historische Nachrichten (Sammlung INr 76615, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:22.396Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "873",
      "incipit_statement": "Herr Consistorialrath Senff zu Halle im Magdeburgischen hat vor einigen Jahren eine Lesegesellschaft für die Landschullehrer der dortigen Gegend, hauptsächlich in seiner Inspection errichtet.",
      "language": [],
      "musenalm_id": 76617,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "2. / Lesebibliothek für Landschulmeister in / dem Magdeburgischen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "2. / Lesebibliothek für Landschulmeister in / dem Magdeburgischen",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1790,
      "editor": "",
      "agents": [],
      "source_id": "w159cdy43xnst3k"
    },
    {
      "annotation": "V. Historische Nachrichten (Sammlung INr 76615, Obj 7)",
      "content_type": [],
      "created": "2026-06-11 10:18:22.396Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "875",
      "incipit_statement": "Das teutsche Schulwesen wird gegenwärtig in diesem Lande ungemein betrieben,",
      "language": [],
      "musenalm_id": 76618,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "3. / Aus dem Fürstenthum Anhalt-Dessau",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "3. / Aus dem Fürstenthum Anhalt-Dessau",
      "updated": "2011-07-27 00:00:00.000Z",
      "variant_title": "",
      "year": 1790,
      "editor": "",
      "agents": [],
      "source_id": "tm9r10flel22f79"
    },
    {
