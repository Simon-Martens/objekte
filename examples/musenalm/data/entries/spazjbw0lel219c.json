      "created": "2026-06-11 10:18:42.856Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "115",
      "incipit_statement": "Nachdem gegenwärtig die kriegslage das nördliche Tirol bedrohet; so wird jeder getreue Tiroler hieraus die Nothwendigkeit ersehen, vorzüglich den mächtigen Beystand des Himmels",
      "language": [],
      "musenalm_id": 111500,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "VII. / Aufruf des K.K.O. Oen. Landesguberniums / einverständlich mit der Triolischen Landschaft / an das getreueste Volk des Landes Tirol. / Innsbruck am 24. März 1797",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "VII. / Aufruf des K.K.O. Oen. Landesguberniums / einverständlich mit der Triolischen Landschaft / an das getreueste Volk des Landes Tirol. / Innsbruck am 24. März 1797",
