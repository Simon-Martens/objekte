    },
    {
      "annotation": "Dem Beitrag vorangestellt: Devota morti pectora liberae! [...] Horat. Lib. IV. Ode 145",
      "content_type": [],
      "created": "2026-06-11 10:18:42.855Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "49",
      "incipit_statement": "Nachdem der Feind am 24. März 1797 Klausen genommen hatte, war die Stadt und der ganze umliegende Bezirk im Raube und der Verheerung desselben Preis gegeben.",
      "language": [],
      "musenalm_id": 111497,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "IV. / Aemtliche Darstellung / der / muthvollen Vertheidigung / der Gebirgengen / von / Latzfons und Villanders / gegen die Franzosen / im Frühjahr 1797",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "IV. / Aemtliche Darstellung / der / muthvollen Vertheidigung / der Gebirgengen / von / Latzfons und Villanders / gegen die Franzosen / im Frühjahr 1797",
