    {
      "annotation": "Dem Text vorangestellt: Genauni, implacidum genus, / Brennique veloces - / Immanesque Rhaeti! / Horat. lib. IV. Ode 14",
      "content_type": [],
      "created": "2026-06-11 10:18:42.855Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "9",
      "incipit_statement": "Alle schönen Hoffnungen und sehnsuchtsvollen Wünsche des Patrioten für den Sieg der gerechten Sache, für die Befreyung des Vaterlandes - am Schlusse des drangvollen Jahres 1796 - wurden durch einen Unglücksfall, die Entscheidugnsschlacht bei Rivoli",
      "language": [],
      "musenalm_id": 111495,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der Masse-Aufstand / der / Tiroler / gegen die Franzosen / im Jahre 1797. / Aus Urkunden",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der Masse-Aufstand / der / Tiroler / gegen die Franzosen / im Jahre 1797. / Aus Urkunden",
      "updated": "2010-01-12 00:00:00.000Z",
      "variant_title": "",
      "year": 1802,
      "editor": "",
