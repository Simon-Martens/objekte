      "source_id": "i589kdne4fxf0t2"
    },
    {
      "annotation": "Dem Beitrag vorangestellt: Dulce et decorum est pro patria mori - - [...] Horat. Lib. III. Ode 2. /) mit zahlreichen Einträgen",
      "content_type": [],
      "created": "2026-06-11 10:18:42.855Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "41",
      "incipit_statement": "Vom Gerichte Sonnenburg, und dessen Gemeinde Natters: Thomas Strobl,Michael Teniger.",
      "language": [],
      "musenalm_id": 111496,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text",
        "Tabelle"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "III. / Verzeichniß / Jener Landesvertheidiger, welche im Handge- / menge des linken Flügels mit den Franzosen / bey Meransen udn Spinges am 2. Aprill / 1797 rühmliche Wunden erhalten haben, / oder auf dem Bette der Ehre / gefallen sind",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
