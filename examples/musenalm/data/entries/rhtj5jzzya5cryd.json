    {
      "annotation": "Dem Text vorangestellt: Motto: Es glänzt ein Licht in dunkler Nacht, von hohem Fels herab, [...] /) mit einer Illustration s. Graphik INr 109891, Obj 1",
      "content_type": [],
      "created": "2026-06-11 10:18:39.425Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Es war eine der dunklesten Nächte, zur Zeit des Herbstäquinoctiums im Jahr 1787, als die Kriegsbrigg der Staaten von Holland das Seepferd nach noch nicht völlig ausgetobtem Sturm, gegen die Wogen der Nordsee kämpfte.",
      "language": [],
      "musenalm_id": 109900,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der Leuchtthurm. / Erzählung in zwei Abtheilungen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "C. von Wachsmann",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der Leuchtthurm. / Erzählung in zwei Abtheilungen",
      "updated": "2010-01-28 00:00:00.000Z",
