      "source_id": "oaafrfbjxci7vth"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:34.003Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "329",
      "incipit_statement": "Ein Dichter hat kein Glück! sagt irgendwo ein Schriftsteller, doch wenn unter Glück nur das blose klingende Metall zu verstehen und der Alltagsmensch keine höhern Interessen damit verknüpft, so hatte die Vorsehung einen jungen Mann, Namens Erwin,",
      "language": [],
      "musenalm_id": 103665,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
