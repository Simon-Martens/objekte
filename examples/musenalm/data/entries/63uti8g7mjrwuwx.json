      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "21",
      "incipit_statement": "Des Festes Ordner schreitet durch den Saal, / Ein kleiner Herrgott, dessen Wort befahl: Verkörpert sei der Seelen liebster Traum, / Das schönste Gotteswort: Es werde Licht!",
      "language": [],
      "musenalm_id": 103655,
      "musenalm_pagination": [
        "Römische Seitenzählung"
      ],
      "musenalm_type": [
