      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "101",
      "incipit_statement": "Es war in der letzten Zeit des Regimentes von Don Antonio Lopez de Santa Anna. Die vereinigte Staaten-Armee war unter ihrem Old Jack, dem General Taylor, in Texas eingerückt.",
      "language": [],
      "musenalm_id": 103663,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
