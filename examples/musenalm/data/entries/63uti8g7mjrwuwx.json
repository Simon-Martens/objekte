      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "26",
      "incipit_statement": "In der Hütte wie saust, wie braust der Wind / Durch die halb geborstenen Mauern! / Seht dort beim bleichen sterbenden Kind / Die zerlumpte Bettlerin kauern.",
      "language": [],
      "musenalm_id": 103657,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Gedicht/Lied"
