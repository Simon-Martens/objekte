      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Die Bettlerin und ihr Kind",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Ed. Kauffer",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Die Bettlerin und ihr Kind",
