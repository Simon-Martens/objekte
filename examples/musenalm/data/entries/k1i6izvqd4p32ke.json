      "source_id": "eyceqhgfawnrdg4"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:17:40.548Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "155",
      "incipit_statement": "Alles ist wahr, nach dem Buchstaben wahr, was Ihre Freunde Ihnen von diesem sonderbaren Volk in Prose und in Versen erzählt haben.",
