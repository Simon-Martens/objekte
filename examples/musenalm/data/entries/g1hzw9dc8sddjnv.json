      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der / römische Kaiser",
      "updated": "2010-02-24 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "nxti615cv0ib2we"
    },
    {
      "annotation": "",
