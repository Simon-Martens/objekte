    {
      "annotation": "laut Anmerkung nach einer wahren Anekdote aus der Regierung des Zars Iwan des Großen",
      "content_type": [],
      "created": "2026-06-11 10:18:52.395Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Bei’m heiligen Nikolas! Solcher glücklichen Tage wie heut’, erlebt’ ich noch wenige.",
      "language": [],
      "musenalm_id": 129802,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "szen. Darstellung"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der / Czaar und der Bauer. / Lustspiel in zwei Aufzügen",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "unbezeichnet",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der / Czaar und der Bauer. / Lustspiel in zwei Aufzügen",
      "updated": "2010-02-24 00:00:00.000Z",
      "variant_title": "",
      "year": 1815,
      "editor": "",
      "agents": [],
      "source_id": "ptzln716teeppzf"
    },
    {
      "annotation": "",
      "content_type": [],
      "created": "2026-06-11 10:18:52.395Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "57",
      "incipit_statement": "Ist das ein Wetterchen da draußen! / Ist das ein Sturm, ist das ein Sausen! / Ist das ein Schnee – Potz Sapperlot! / Mich schlugen fast die Flocken todt.",
      "language": [],
      "musenalm_id": 129803,
      "musenalm_pagination": [
