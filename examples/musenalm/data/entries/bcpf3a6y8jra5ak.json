    {
      "annotation": "Mit einer Widmung: Seinen werthen Freunden zu Augsburg, der Familie L****g, als Denkmal seiner Liebe und Anhänglichkeit geweiht. /) Dem Text vorangestellt: Das ist der Liebe heil'ger Götterstrahl / Der in die Seele schlägt und trifft und zündet, [...] Schiller /) mit 2 Illustrationen s. Graphiken im Kalendarium INr 120463, 120464; Obj 14, 15",
      "content_type": [],
      "created": "2026-06-11 10:18:46.764Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "1",
      "incipit_statement": "Kaum hatte der erste Strahl des erwachenden Tages, es war der 24. im Monat Julius des Jahres 1548, mit seinem ersehnten Schimmer den äußersten Rand des Horizontes schwach zu röthen begonnen,",
      "language": [],
      "musenalm_id": 120475,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Prosa"
      ],
      "parallel_title": "",
      "place_statement": "",
      "preferred_title": "Der / letzte Ritter und sein Lieb. / Historisch-romantische Skizze aus / Augsburgs Vorzeit",
      "pseudonym": false,
      "publication_statement": "",
      "responsibility_statement": "Dr. E. N. Falkner",
      "scans": [],
      "subtitle_statement": "",
      "title_statement": "Der / letzte Ritter und sein Lieb. / Historisch-romantische Skizze aus / Augsburgs Vorzeit",
      "updated": "2009-01-29 00:00:00.000Z",
      "variant_title": "",
      "year": 1845,
      "editor": "",
      "agents": [],
      "source_id": "i1m2o6kgac8sylk"
    },
