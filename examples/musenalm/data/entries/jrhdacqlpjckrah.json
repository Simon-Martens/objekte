    {
      "annotation": "Inhaltsangabe zu »Volksscenen aus dem Amphitryon« INr 73149, Obj 13",
      "content_type": [],
      "created": "2026-06-11 10:18:16.893Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "172",
      "incipit_statement": "Jupiter und Merkur sind, in der Gestalt des Sofia und des Amphitryon, nieder auf die Erde gestiegen,",
      "language": [],
      "musenalm_id": 73147,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
        "Text"
