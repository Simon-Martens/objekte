      "source_id": "0w0usv9jmp6q6zc"
    },
    {
      "annotation": "mit Inhaltsangabe und Vorerinnerung INr 73147, 73148, Obj 11, 12 und Nachschrift INr 73150, Obj 14 /) mit einer Illustration s. Titelgraphik INr 73138, Obj 2",
      "content_type": [],
      "created": "2026-06-11 10:18:16.893Z",
      "dimensions": "",
      "edit_comment": "",
      "edit_state": "Edited",
      "extent": "182",
      "incipit_statement": "Wie? Kaum ist dir in's Haus zurück der / Mann: / So geht der Zank auch schon auf's Neue an!",
      "language": [],
      "musenalm_id": 73149,
      "musenalm_pagination": [
        "Arabische Seitenzählung"
      ],
      "musenalm_type": [
