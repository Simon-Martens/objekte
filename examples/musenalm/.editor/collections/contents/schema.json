            "type": "boolean",
            "default": false
          },
          "uncertain": {
            "type": "boolean",
            "default": false
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "updated": {
            "type": "string",
            "format": "date-time"
          },
          "annotation": {
            "type": "string"
          },
          "edit_comment": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "agents",
          "type"
        ],
        "additionalProperties": false
      }
    }
