{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project content",
  "x-project": {
    "media": "media"
  },
  "$defs": {
    "personReference": {
      "type": "string",
      "x-editor": "relation",
      "x-relation": {
        "collection": "people"
      }
    }
  },
  "anyOf": [
    {
      "title": "Person",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Name",
          "minLength": 1
        },
        "birthplace": {
          "type": [
            "string",
            "null"
          ],
          "title": "Birthplace"
        },
        "birthYear": {
          "type": [
            "integer",
            "null"
          ],
          "title": "Birth year"
        },
        "tags": {
          "type": "array",
          "title": "Tags",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "object",
          "title": "Links",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "x-collection": {
        "name": "people",
        "label": "People",
        "path": "data/people",
        "format": "json",
        "id": "filename",
        "display": "name",
        "search": [
          "name",
          "birthplace"
        ]
      }
    },
    {
      "title": "Article",
      "type": "object",
      "required": [
        "id",
        "title",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "ID",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "title": "Title",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "title": "Author",
          "x-editor": "relation",
          "x-relation": {
            "collection": "people"
          }
        },
        "contributors": {
          "type": "array",
          "title": "Contributors",
          "items": {
            "$ref": "#/$defs/personReference"
          }
        },
        "published": {
          "type": "boolean",
          "title": "Published"
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "title": "Image",
          "x-editor": "media"
        },
        "body": {
          "type": "string",
          "title": "Body",
          "x-editor": "markdown"
        }
      },
      "additionalProperties": true,
      "x-collection": {
        "name": "articles",
        "label": "Articles",
        "path": "data/articles",
        "format": "markdown",
        "id": "frontmatter.id",
        "display": "title",
        "search": [
          "title"
        ]
      }
    }
  ]
}
