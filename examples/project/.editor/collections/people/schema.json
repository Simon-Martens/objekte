      "type": "string",
      "minLength": 1
    },
    "birthplace": {
      "type": [
        "string",
        "null"
      ]
    },
    "birthYear": {
      "type": [
        "integer",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "object",
