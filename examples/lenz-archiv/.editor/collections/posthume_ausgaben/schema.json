{
  "type": "object",
  "required": [
    "Jahr",
    "Sort",
    "Eintrag"
  ],
  "properties": {
    "source": {
      "type": "string",
      "x-ownership": {
        "kind": "imported",
        "editable": false,
        "onCreate": "omit"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "x-content": "media"
      }
    },
    "Jahr": {
      "type": "integer"
    },
    "Sort": {
      "type": "integer"
    },
    "Eintrag": {
      "type": "string",
      "x-content": "markdown"
    },
    "Kommentare": {
      "type": "array",
      "items": {
        "type": "string",
        "x-content": "markdown"
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
