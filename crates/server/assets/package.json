{
  "name": "objekte-server-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:search": "node ../../../scripts/build-search-wasm.mjs",
    "prebuild": "npm run build:search",
    "predev": "npm run build:search",
    "test:search": "npm run build:search && node --test --test-isolation=none ../../../scripts/search-wasm.test.mjs tests/search-controls.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "monaco-editor": "0.57.0",
    "remixicon": "^4.9.1",
    "tippy.js": "6.3.7"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
